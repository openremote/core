# Copy to .local/loadtest.env and edit before running test/or-eks-load.
# This is a trusted Bash file. Keep AWS access keys out of it.
LOAD_TEST=load2
LOAD_PROFILE=xlarge
CLUSTER_NAME=loadtest
STACK_NAME=load2
AWS_REGION=eu-west-1
LOAD_HOSTNAME=load2.example.com
LOAD_MANAGER_REPOSITORY=123456789012.dkr.ecr.eu-west-1.amazonaws.com/openremote/manager

# Leave empty to use the cluster credentials, or name the DNS account's profile.
DNS_AWS_PROFILE=""
# Cluster commands use the normal AWS credential chain by default.
# CLUSTER_AWS_PROFILE=my-cluster-account
