{
  "name": "openremote",
  "packageManager": "yarn@4.18.0",
  "private": true,
  "scripts": {
    "knip": "knip -c ui/knip.ts",
    "test:knip": "yarn workspace @openremote/util test:knip",
    "test:ui-locks": "yarn workspace @openremote/util test:ui-locks",
    "lint": "cd ui && eslint . --cache --cache-location ../.eslintcache",
    "lint:fix": "cd ui && eslint . --fix --cache --cache-location ../.eslintcache",
    "format": "cd ui && prettier . --write",
    "format:check": "cd ui && prettier . --check"
  },
  "workspaces": [
    "ui/util",
    "ui/test",
    "ui/app/*",
    "ui/component/*",
    "ui/demo/*"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "8.40.0",
    "@typescript-eslint/parser": "8.40.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-wc": "3.1.0",
    "knip": "6.43.0",
    "prettier": "3.9.6",
    "typescript": "~5.9.3"
  }
}
