{
  "name": "@openremote/or-map",
  "version": "1.28.0-snapshot",
  "description": "Displays s vector or raster map",
  "customElements": "build/custom-elements.json",
  "main": "build/dist/umd/index.bundle.js",
  "module": "build/lib/index.js",
  "exports": {
    ".": "./build/lib/index.js",
    "./*": "./build/lib/*.js",
    "./jsx": {
      "types": "./build/custom-elements-jsx.d.ts"
    }
  },
  "types": "build/lib/index.d.ts",
  "files": [
    "build/lib/**",
    "build/dist/**",
    "build/custom-elements.json",
    "build/custom-elements-jsx.d.ts"
  ],
  "scripts": {
    "analyze": "npx cem analyze --config ../custom-elements-manifest.config.mjs",
    "build": "npx tsc -b",
    "test": "npx tsc -b && npx playwright test",
    "prepack": "npx rspack"
  },
  "author": "OpenRemote",
  "repository": "https://github.com/openremote/core",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@openremote/core": "workspace:*",
    "@openremote/model": "workspace:*",
    "@openremote/or-element": "workspace:*",
    "@openremote/or-icon": "workspace:*",
    "@openremote/or-translate": "workspace:*",
    "@openremote/or-vaadin-components": "workspace:*",
    "lit": "^3.3.1",
    "lit-html": "^3.3.1",
    "lodash.debounce": "^4.0.8",
    "maplibre-gl": "~6.8.0"
  },
  "devDependencies": {
    "@openremote/util": "workspace:*",
    "@types/geojson": "^7946.0.7",
    "@types/lodash.debounce": "^4"
  },
  "publishConfig": {
    "access": "public"
  }
}
