{
  "name": "@openremote/or-app",
  "version": "1.28.0-snapshot",
  "description": "OpenRemote app template",
  "customElements": "build/custom-elements.json",
  "author": "OpenRemote",
  "license": "AGPL-3.0-or-later",
  "main": "build/dist/umd/index.bundle.js",
  "module": "build/lib/index.js",
  "exports": {
    ".": "./build/lib/index.js",
    "./images/*": "./src/images/*",
    "./*": "./build/lib/*.js",
    "./jsx": {
      "types": "./build/custom-elements-jsx.d.ts"
    }
  },
  "types": "build/lib/index.d.ts",
  "files": [
    "src/images/**",
    "build/lib/**",
    "build/dist/**",
    "build/custom-elements.json",
    "build/custom-elements-jsx.d.ts"
  ],
  "scripts": {
    "analyze": "npx cem analyze --config ../custom-elements-manifest.config.mjs",
    "clean": "npx tsc -b --clean && npx shx rm -rf build",
    "modelBuild": "npx orutil build",
    "modelWatch": "npx orutil watch",
    "build": "npx cross-env NODE_OPTIONS=--max_old_space_size=4096 rspack --mode production",
    "test": "echo \"No tests\" && exit 0",
    "prepack": "npx tsc -b && npx rspack"
  },
  "dependencies": {
    "@openremote/core": "workspace:*",
    "@openremote/model": "workspace:*",
    "@openremote/or-components": "workspace:*",
    "@openremote/or-element": "workspace:*",
    "@openremote/or-icon": "workspace:*",
    "@openremote/or-mwc-components": "workspace:*",
    "@openremote/or-translate": "workspace:*",
    "@openremote/or-vaadin-components": "workspace:*",
    "@reduxjs/toolkit": "^2.12.0",
    "@webcomponents/webcomponentsjs": "^2.6.0",
    "lit": "^3.3.1",
    "navigo": "^8.11.1",
    "pwa-helpers": "^0.9.0"
  },
  "devDependencies": {
    "@openremote/util": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
