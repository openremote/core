{
  "name": "@openremote/or-rules",
  "version": "1.28.0-snapshot",
  "description": "OpenRemote rules related UI components",
  "customElements": "build/custom-elements.json",
  "main": "build/dist/umd/index.bundle.js",
  "module": "build/lib/index.js",
  "exports": {
    ".": "./build/lib/index.js",
    "./*": "./build/lib/*.js",
    "./jsx": {
      "types": "./build/custom-elements-jsx.d.ts"
    }
  },
  "types": "build/lib/index.d.ts",
  "files": [
    "build/lib/**",
    "build/dist/**",
    "build/custom-elements.json",
    "build/custom-elements-jsx.d.ts"
  ],
  "scripts": {
    "analyze": "npx cem analyze --config ../custom-elements-manifest.config.mjs",
    "test": "echo \"No tests\" && exit 0",
    "prepack": "npx rspack"
  },
  "author": "OpenRemote",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@openremote/core": "workspace:*",
    "@openremote/model": "workspace:*",
    "@openremote/or-asset-tree": "workspace:*",
    "@openremote/or-attribute-input": "workspace:*",
    "@openremote/or-attribute-picker": "workspace:*",
    "@openremote/or-components": "workspace:*",
    "@openremote/or-element": "workspace:*",
    "@openremote/or-icon": "workspace:*",
    "@openremote/or-map": "workspace:*",
    "@openremote/or-mwc-components": "workspace:*",
    "@openremote/or-scheduler": "workspace:*",
    "@openremote/or-translate": "workspace:*",
    "@openremote/or-tree-menu": "workspace:*",
    "@openremote/or-vaadin-components": "workspace:*",
    "@openremote/rest": "workspace:*",
    "@types/lodash": "4.17.23",
    "ace-builds": "^1.44.0",
    "axios": "1.20.0",
    "i18next": "^26.3.6",
    "iso-639-1": "^3.1.6",
    "linqts": "^3.2.0",
    "lit": "^3.3.1",
    "lodash.debounce": "^4.0.8",
    "moment": "^2.31.0",
    "resize-observer": "^1.0.3",
    "shortid": "^2.2.15"
  },
  "devDependencies": {
    "@openremote/util": "workspace:*",
    "@types/shortid": "^0.0.29"
  },
  "publishConfig": {
    "access": "public"
  }
}
