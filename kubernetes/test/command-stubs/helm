#!/usr/bin/env bash

set -eu

printf 'helm' >> "$OR_STACK_TEST_LOG"
for argument in "$@"; do
  printf '\t%s' "$argument" >> "$OR_STACK_TEST_LOG"
done
printf '\n' >> "$OR_STACK_TEST_LOG"

if [ "${1:-}" = version ]; then
  printf '%s\n' "${OR_STACK_TEST_HELM_VERSION:-v3.20.0}"
fi

if [ "${1:-}" = upgrade ] && [ "${3:-}" = "${OR_STACK_TEST_HELM_FAIL_RELEASE:-}" ]; then
  exit 1
fi
