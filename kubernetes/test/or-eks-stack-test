  local OR_EKS_STACK_TEST_RECORDED_MQTTS_CERTIFICATE_MODE=existing
  local OR_EKS_STACK_TEST_RECORDED_MQTTS_HOSTNAME=mqtt-stack-a.example.com
  local OR_EKS_STACK_TEST_LOAD_BALANCERS_JSON="$DEFAULT_LOAD_BALANCERS_JSON"
  local OR_EKS_STACK_TEST_NAMESPACE_EXISTS=true
  local OR_EKS_STACK_TEST_MQTTS_SERVICE_EXISTS=true

  registry="$(jq '.data["mqtt-stack-a.example.com"] =
    ({namespace:"stack-a",namespaceUID:"uid-stack-a",target:"eks",dns:"external-dns",
      exposure:"ingress",endpoint:"mqtts"}|tojson)' <<< "$DEFAULT_HOSTNAME_REGISTRY_JSON")"
  OR_EKS_STACK_TEST_REGISTRY_JSON="$registry"

  # AWS can retain an NLB after Kubernetes reports deletion. Each invocation
  # starts with empty process state, including retries after namespace removal.
  for state in initial namespace-absent service-absent; do
    OR_EKS_STACK_TEST_NAMESPACE_EXISTS=true
    OR_EKS_STACK_TEST_MQTTS_SERVICE_EXISTS=true
    case "$state" in
      namespace-absent) OR_EKS_STACK_TEST_NAMESPACE_EXISTS=false ;;
      service-absent) OR_EKS_STACK_TEST_MQTTS_SERVICE_EXISTS=false ;;
    esac
    if failure_output="$(run_eks_stack destroy --name stack-a --cluster test-cluster \
        --profile '' --confirm stack-a --timeout 1s 2>&1)"; then
      fail "Destroy released reservations with a retained MQTTS NLB ($state)"
    fi
    grep -F 'MQTTS NLB deletion' <<< "$failure_output" >/dev/null || fail "$failure_output"
    assert_contains $'aws-elbv2\tdescribe-tags\t--resource-arns\t'"$TEST_MQTTS_NLB_ARN"
    assert_not_contains $'or-stack\trelease-hostname'
    assert_not_contains $'aws-acm\tdelete-certificate'
    if [ "$state" = namespace-absent ]; then
      assert_not_contains $'or-stack\tdestroy'
    fi
  done

  OR_EKS_STACK_TEST_NAMESPACE_EXISTS=false
  # A later retry succeeds only once the AWS resource is gone.
  OR_EKS_STACK_TEST_LOAD_BALANCERS_JSON='{"LoadBalancers":[]}' \
    run_eks_stack destroy --name stack-a --cluster test-cluster \
      --profile '' --confirm stack-a >/dev/null
  assert_not_contains $'or-stack\tdestroy'
  assert_before $'aws-elbv2\tdescribe-load-balancers' $'or-stack\trelease-hostname'
  assert_contains $'--hostname\tmqtt-stack-a.example.com\t--confirm\tstack-a'
  assert_contains $'--hostname\tstack-a.example.com\t--confirm\tstack-a'

  # Neither another cluster's identically named Service nor another stack's
  # NLB in this cluster should block releasing this stack's reservations.
  OR_EKS_STACK_TEST_NLB_CLUSTER=another-cluster \
    run_eks_stack destroy --name stack-a --cluster test-cluster \
      --profile '' --confirm stack-a >/dev/null
  assert_contains $'or-stack\trelease-hostname'
  OR_EKS_STACK_TEST_NLB_SERVICE=stack-b/proxy-mqtts \
    run_eks_stack destroy --name stack-a --cluster test-cluster \
      --profile '' --confirm stack-a >/dev/null
  assert_contains $'or-stack\trelease-hostname'

  for error_kind in list tags malformed-list malformed-tags empty-list empty-tags; do
    local OR_EKS_STACK_TEST_ELB_LIST_ERROR=""
    local OR_EKS_STACK_TEST_ELB_TAGS_ERROR=""
    local OR_EKS_STACK_TEST_ELB_TAGS_JSON=""
    OR_EKS_STACK_TEST_LOAD_BALANCERS_JSON="$DEFAULT_LOAD_BALANCERS_JSON"
    case "$error_kind" in
      list) OR_EKS_STACK_TEST_ELB_LIST_ERROR='AccessDenied' ;;
      tags) OR_EKS_STACK_TEST_ELB_TAGS_ERROR='AccessDenied' ;;
      malformed-list) OR_EKS_STACK_TEST_LOAD_BALANCERS_JSON='{}' ;;
      malformed-tags) OR_EKS_STACK_TEST_ELB_TAGS_JSON='{}' ;;
      empty-list) OR_EKS_STACK_TEST_LOAD_BALANCERS_JSON=' ' ;;
      empty-tags) OR_EKS_STACK_TEST_ELB_TAGS_JSON=' ' ;;
    esac
    if failure_output="$(run_eks_stack destroy --name stack-a --cluster test-cluster \
        --profile '' --confirm stack-a 2>&1)"; then
      fail "Destroy released reservations after an AWS lookup failure ($error_kind)"
    fi
    assert_not_contains $'or-stack\trelease-hostname'
    assert_not_contains $'aws-acm\tdelete-certificate'
  done

  # Disappearing between list and describe-tags is a confirmed deletion, not
  # an authorization failure or a reason to keep a completed cleanup blocked.
  OR_EKS_STACK_TEST_ELB_TAGS_ERROR='An error occurred (LoadBalancerNotFound)' \
    run_eks_stack destroy --name stack-a --cluster test-cluster \
      --profile '' --confirm stack-a >/dev/null
  assert_contains $'or-stack\trelease-hostname'
}

