  data:{"stack-a.example.com":({namespace:"stack-a",namespaceUID:"uid-stack-a",target:"eks",dns:"external-dns",exposure:"ingress"}|tojson)}}')"

cleanup_test() {
  rm -rf "$TEST_TEMP_DIR"
}

trap cleanup_test EXIT

# Source the command so external tools and the portable stack invocation can be
# replaced with deterministic stubs.
source "$KUBERNETES_DIR/or-eks-stack"

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

log_call() {
  local command="$1"
  shift
  printf '%s' "$command" >> "$CALL_LOG"
  for argument in "$@"; do
    printf '\t%s' "$argument" >> "$CALL_LOG"
  done
  printf '\n' >> "$CALL_LOG"
}

assert_contains() {
  local expected="$1"
  grep -F -- "$expected" "$CALL_LOG" >/dev/null || fail \
    "Expected command log to contain: $expected"
}

assert_not_contains() {
  local unexpected="$1"
  if grep -F -- "$unexpected" "$CALL_LOG" >/dev/null; then
    fail "Expected command log not to contain: $unexpected"
  fi
}

assert_before() {
  local first="$1"
  local first_line
  local second="$2"
  local second_line

  first_line="$(grep -nF -- "$first" "$CALL_LOG" | head -n 1 | cut -d: -f1)"
  second_line="$(grep -nF -- "$second" "$CALL_LOG" | head -n 1 | cut -d: -f1)"
  [ -n "$first_line" ] || fail "Expected command log to contain: $first"
  [ -n "$second_line" ] || fail "Expected command log to contain: $second"
  [ "$first_line" -lt "$second_line" ] || fail \
    "Expected '$first' before '$second'"
}

reset_test() {
  : > "$CALL_LOG"
  : > "$DNS_ENDPOINT_LOG"
  rm -f "$CERTIFICATE_DELETED_FILE" "$INGRESS_DELETED_FILE" \
    "$MQTTS_CERTIFICATE_DELETED_FILE" "$NAMESPACE_DELETED_FILE" \
    "$NAMESPACE_PREPARED_FILE" "$CERTIFICATE_NAMESPACE_FILE"
  printf '0\n' > "$CURL_COUNT_FILE"
  rm -rf "$PROXY_LE_DIR"
  case "${OR_EKS_STACK_TEST_PROXY_CERTIFICATE_STATE:-absent}" in
    present) create_proxy_certificate ;;
    incomplete) mkdir -p "$PROXY_LE_DIR/live/stack-a.example.com" ;;
  esac
  COMMAND=""
  STACK_NAME=""
  CLUSTER_NAME=""
  AWS_REGION_NAME="eu-west-1"
  AWS_PROFILE_NAME=""
  KUBE_CONTEXT=""
  EXPOSURE="haproxy"
  HOSTNAME_VALUE=""
  CERTIFICATE_MODE=""
  CERTIFICATE_ARN=""
  VALUES_DIR=""
  TIMEOUT="20m"
  HTTP_PORT="80"
  HTTPS_PORT="443"
  MQTTS_ENABLED=false
  MQTTS_PORT="8883"
  MQTTS_PORT_CONFIGURED=false
  MQTTS_HOSTNAME_VALUE=""
  MQTTS_CERTIFICATE_MODE=""
  MQTTS_CERTIFICATE_ARN=""
  CONFIRM_STACK_NAME=""
  OR_STACK_COMMAND="$KUBERNETES_DIR/or-stack"
  LOAD_BALANCER_ADDRESS=""
  MQTTS_LOAD_BALANCER_ADDRESS=""
  EXTERNAL_DNS_ARGS=""
  CERTIFICATE_JSON=""
  CERTIFICATE_EXISTS=false
  MQTTS_CERTIFICATE_JSON=""
  MQTTS_CERTIFICATE_EXISTS=false
  STACK_NAMESPACE_EXISTS=false
  VALIDATION_DNS_RECORDS=""
  MQTTS_VALIDATION_DNS_RECORDS=""
  MANAGED_DNS_DOMAIN=""
  AUTHORITATIVE_NAME_SERVERS=""
  STACK_INGRESS_JSON=""
  STACK_MQTTS_SERVICE_JSON=""
  VALIDATION_DNS_ENDPOINT_EXISTS=false
  MQTTS_VALIDATION_DNS_ENDPOINT_EXISTS=false
  MANAGED_CERTIFICATE_DESTROY=false
  MANAGED_MQTTS_CERTIFICATE_DESTROY=false
}

require_command() {
  :
}

aws_eks() {
  log_call aws-eks "$@"
  case " $* " in
    *" cluster.status "*)
      printf '%s\n' "${OR_EKS_STACK_TEST_CLUSTER_STATUS:-ACTIVE}"
      ;;
    *" cluster.endpoint "*)
      printf '%s\n' "$TEST_CLUSTER_ENDPOINT"
      ;;
  esac
}

aws_sts() {
  log_call aws-sts "$@"
  printf '%s\n' "${OR_EKS_STACK_TEST_ACCOUNT_ID:-123456789012}"
}

aws_acm() {
  log_call aws-acm "$@"
  case " $* " in
    *" delete-certificate "*)
      if [[ " $* " == *" $TEST_MQTTS_CERTIFICATE_ARN "* ]]; then
        : > "$MQTTS_CERTIFICATE_DELETED_FILE"
      else
        : > "$CERTIFICATE_DELETED_FILE"
      fi
      ;;
    *" list-certificates "*)
      printf '%s\n' "${OR_EKS_STACK_TEST_CERTIFICATE_LIST-$DEFAULT_CERTIFICATE_LIST}"
      ;;
    *" request-certificate "*)
      [ "${OR_EKS_STACK_TEST_ACM_REQUEST_FAIL:-false}" = false ] || return 1
      if [ -n "${OR_EKS_STACK_TEST_REQUESTED_CERTIFICATE_ARN:-}" ]; then
        printf '%s\n' "$OR_EKS_STACK_TEST_REQUESTED_CERTIFICATE_ARN"
      elif [[ " $* " == *" --domain-name mqtt-stack-a.example.com "* ]]; then
        printf '%s\n' "$TEST_MQTTS_CERTIFICATE_ARN"
      else
        printf '%s\n' "$TEST_CERTIFICATE_ARN"
      fi
      ;;
    *" list-tags-for-certificate "*)
      if [[ " $* " == *" $TEST_MQTTS_CERTIFICATE_ARN "* ]]; then
        printf '%s\n' "${OR_EKS_STACK_TEST_MQTTS_CERTIFICATE_TAGS-${OR_EKS_STACK_TEST_CERTIFICATE_TAGS-$DEFAULT_CERTIFICATE_TAGS}}"
      else
        printf '%s\n' "${OR_EKS_STACK_TEST_CERTIFICATE_TAGS-$DEFAULT_CERTIFICATE_TAGS}"
      fi
      ;;
    *" Certificate.Status "*)
      if { [[ " $* " == *" $TEST_MQTTS_CERTIFICATE_ARN "* ]] && \
           [ -f "$MQTTS_CERTIFICATE_DELETED_FILE" ]; } || \
         { [[ " $* " != *" $TEST_MQTTS_CERTIFICATE_ARN "* ]] && \
           [ -f "$CERTIFICATE_DELETED_FILE" ]; }; then
        printf '%s\n' 'ResourceNotFoundException' >&2
        return 1
      fi
      if [[ " $* " == *" $TEST_MQTTS_CERTIFICATE_ARN "* ]]; then
        printf '%s\n' "${OR_EKS_STACK_TEST_MQTTS_CERTIFICATE_STATUS-${OR_EKS_STACK_TEST_CERTIFICATE_STATUS:-ISSUED}}"
      else
        printf '%s\n' "${OR_EKS_STACK_TEST_CERTIFICATE_STATUS:-ISSUED}"
      fi
      ;;
    *" describe-certificate "*)
      if { [[ " $* " == *" $TEST_MQTTS_CERTIFICATE_ARN "* ]] && \
           [ -f "$MQTTS_CERTIFICATE_DELETED_FILE" ]; } || \
         { [[ " $* " != *" $TEST_MQTTS_CERTIFICATE_ARN "* ]] && \
           [ -f "$CERTIFICATE_DELETED_FILE" ]; }; then
        printf '%s\n' 'ResourceNotFoundException' >&2
        return 1
      fi
      if [[ " $* " == *" $TEST_MQTTS_CERTIFICATE_ARN "* ]]; then
        printf '%s\n' "${OR_EKS_STACK_TEST_MQTTS_CERTIFICATE_JSON-${OR_EKS_STACK_TEST_CERTIFICATE_JSON-$DEFAULT_CERTIFICATE_JSON}}"
      else
        printf '%s\n' "${OR_EKS_STACK_TEST_CERTIFICATE_JSON-$DEFAULT_CERTIFICATE_JSON}"
      fi
      ;;
  esac
}

aws_elbv2() {
  log_call aws-elbv2 "$@"
  case "$1" in
    describe-load-balancers)
      if [ -n "${OR_EKS_STACK_TEST_ELB_LIST_ERROR:-}" ]; then
        printf '%s\n' "$OR_EKS_STACK_TEST_ELB_LIST_ERROR" >&2
        return 1
      fi
      if [ -n "${OR_EKS_STACK_TEST_LOAD_BALANCERS_JSON:-}" ]; then
        printf '%s\n' "$OR_EKS_STACK_TEST_LOAD_BALANCERS_JSON"
      elif [ -f "$NAMESPACE_DELETED_FILE" ] || \
           [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = false ]; then
        printf '%s\n' '{"LoadBalancers":[]}'
      else
        printf '%s\n' "$DEFAULT_LOAD_BALANCERS_JSON"
      fi
      ;;
    describe-tags)
      if [ -n "${OR_EKS_STACK_TEST_ELB_TAGS_ERROR:-}" ]; then
        printf '%s\n' "$OR_EKS_STACK_TEST_ELB_TAGS_ERROR" >&2
        return 1
      fi
      if [ -n "${OR_EKS_STACK_TEST_ELB_TAGS_JSON:-}" ]; then
        printf '%s\n' "$OR_EKS_STACK_TEST_ELB_TAGS_JSON"
      else
        jq -cn --arg arn "$3" \
          --arg cluster "${OR_EKS_STACK_TEST_NLB_CLUSTER:-test-cluster}" \
          --arg service "${OR_EKS_STACK_TEST_NLB_SERVICE:-stack-a/proxy-mqtts}" \
          '{TagDescriptions:[{ResourceArn:$arn,Tags:[
            {Key:"elbv2.k8s.aws/cluster",Value:$cluster},
            {Key:"service.k8s.aws/stack",Value:$service}]}]}'
      fi
      ;;
    *) fail "Unexpected ELB command: $*" ;;
  esac
}

helm() {
  log_call helm "$@"
  [ "${OR_EKS_STACK_TEST_EXTERNAL_DNS_HELM_READY:-true}" = "true" ]
}

kubectl() {
  log_call kubectl "$@"
  local arguments=" $* "
  local endpoint_manifest

  case "$arguments" in
    *" get namespace stack-a"*" -o json "*)
      [ "${OR_EKS_STACK_TEST_NAMESPACE_READ_SUCCESS:-true}" = true ] || return 1
      if [ -f "$CERTIFICATE_NAMESPACE_FILE" ]; then
        cat "$CERTIFICATE_NAMESPACE_FILE"
      elif [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = true ] || [ -f "$NAMESPACE_PREPARED_FILE" ]; then
        jq -cn --arg mode "${OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_MODE:-}" \
          --arg arn "${OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_ARN:-}" \
          --arg mqttsMode "${OR_EKS_STACK_TEST_RECORDED_MQTTS_CERTIFICATE_MODE:-}" \
          --arg mqttsArn "${OR_EKS_STACK_TEST_RECORDED_MQTTS_CERTIFICATE_ARN:-}" \
          --arg mqttsHostname "${OR_EKS_STACK_TEST_RECORDED_MQTTS_HOSTNAME:-}" \
          --arg owner "${OR_EKS_STACK_TEST_NAMESPACE_STACK_LABEL:-stack-a}" \
          '{metadata:{name:"stack-a",uid:"uid-stack-a",resourceVersion:"1",labels:{"openremote.io/stack":$owner},
            annotations:{"openremote.io/certificate-mode":$mode,"openremote.io/certificate-arn":$arn,
              "openremote.io/mqtts-certificate-mode":$mqttsMode,
              "openremote.io/mqtts-certificate-arn":$mqttsArn,
              "openremote.io/mqtts-hostname":$mqttsHostname}}}'
      fi
      ;;
    *" annotate namespace stack-a "*)
      local certificate_namespace argument annotation_key annotation_value
      certificate_namespace="$(kubectl --context "$KUBE_CONTEXT" get namespace stack-a -o json)" || return 1
      for argument in "$@"; do
        case "$argument" in
          --resource-version=*)
            if [ "${OR_EKS_STACK_TEST_MODE_CONFLICT:-false}" = true ] || \
               [ "${argument#*=}" != "$(jq -r '.metadata.resourceVersion' <<< "$certificate_namespace")" ]; then
              printf 'Error from server (Conflict): namespace has changed (requested %s, current %s)\n' \
                "${argument#*=}" "$(jq -r '.metadata.resourceVersion' <<< "$certificate_namespace")" >&2
              return 1
            fi
            ;;
          openremote.io/*=*)
            annotation_key="${argument%%=*}"
            annotation_value="${argument#*=}"
            certificate_namespace="$(jq --arg key "$annotation_key" --arg value "$annotation_value" \
              '.metadata.annotations[$key]=$value' <<< "$certificate_namespace")"
            ;;
        esac
      done
      jq '.metadata.resourceVersion |= (tonumber + 1 | tostring)' \
        <<< "$certificate_namespace" > "$CERTIFICATE_NAMESPACE_FILE"
      ;;
    *" get configmap openremote-hostnames "*)
      printf '%s' "${OR_EKS_STACK_TEST_REGISTRY_JSON-$DEFAULT_HOSTNAME_REGISTRY_JSON}"
      ;;
    *" get ingressclass openremote-alb "*"shared-certificate-arn"*)
      printf '%s' "${OR_EKS_STACK_TEST_SHARED_CERTIFICATE_ARN-}"
      ;;
    *" config get-contexts "*)
      if [ "${OR_EKS_STACK_TEST_CONTEXT_EXISTS:-true}" = "true" ]; then
        printf '%s\n' "${KUBE_CONTEXT:-test-cluster@eu-west-1}"
      fi
      ;;
    *" config view "*)
      printf '%s' "${OR_EKS_STACK_TEST_CONTEXT_ENDPOINT:-$TEST_CLUSTER_ENDPOINT}"
      ;;
    *" get namespace kube-system "*)
      [ "${OR_EKS_STACK_TEST_CONTEXT_REACHABLE:-true}" = "true" ]
      ;;
    *" get namespace stack-a "*"mqtts-certificate-mode"*)
      if [ -f "$CERTIFICATE_NAMESPACE_FILE" ]; then
        jq -r '.metadata.annotations["openremote.io/mqtts-certificate-mode"] // empty' "$CERTIFICATE_NAMESPACE_FILE"
      else
        printf '%s' "${OR_EKS_STACK_TEST_RECORDED_MQTTS_CERTIFICATE_MODE:-}"
      fi
      ;;
    *" get namespace stack-a "*"mqtts-certificate-arn"*)
      if [ -f "$CERTIFICATE_NAMESPACE_FILE" ]; then
        jq -r '.metadata.annotations["openremote.io/mqtts-certificate-arn"] // empty' "$CERTIFICATE_NAMESPACE_FILE"
      else
        printf '%s' "${OR_EKS_STACK_TEST_RECORDED_MQTTS_CERTIFICATE_ARN:-}"
      fi
      ;;
    *" get namespace stack-a "*"mqtts-hostname"*)
      if [ -f "$CERTIFICATE_NAMESPACE_FILE" ]; then
        jq -r '.metadata.annotations["openremote.io/mqtts-hostname"] // empty' "$CERTIFICATE_NAMESPACE_FILE"
      else
        printf '%s' "${OR_EKS_STACK_TEST_RECORDED_MQTTS_HOSTNAME:-}"
      fi
      ;;
    *" get namespace stack-a "*"certificate-mode"*)
      if [ -f "$CERTIFICATE_NAMESPACE_FILE" ]; then
        jq -r '.metadata.annotations["openremote.io/certificate-mode"] // empty' "$CERTIFICATE_NAMESPACE_FILE"
      else
        printf '%s' "${OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_MODE:-acme}"
      fi
      ;;
    *" get namespace stack-a "*"certificate-arn"*)
      if [ -f "$CERTIFICATE_NAMESPACE_FILE" ]; then
        jq -r '.metadata.annotations["openremote.io/certificate-arn"] // empty' "$CERTIFICATE_NAMESPACE_FILE"
      else
        printf '%s' "${OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_ARN:-}"
      fi
      ;;
    *" get namespace stack-a "*"openremote.io/hostname"*)
      printf '%s' "${OR_EKS_STACK_TEST_RECORDED_HOSTNAME:-}"
      ;;
    *" get namespace stack-a "*"openremote.io/stack"*)
      if [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = "true" ] && \
         [ ! -f "$NAMESPACE_DELETED_FILE" ]; then
        printf 'stack-a|%s' "${OR_EKS_STACK_TEST_NAMESPACE_STACK_LABEL:-stack-a}"
      fi
      ;;
    *" rollout status deployment/openremote-external-dns "*)
      [ "${OR_EKS_STACK_TEST_EXTERNAL_DNS_ROLLOUT_READY:-true}" = "true" ]
      ;;
    *" get deployment openremote-external-dns "*)
      printf '%s\n' "${OR_EKS_STACK_TEST_EXTERNAL_DNS_ARGS-$DEFAULT_EXTERNAL_DNS_ARGS}"
      ;;
    *" get customresourcedefinition/dnsendpoints.externaldns.k8s.io "*)
      if [ "${OR_EKS_STACK_TEST_DNS_ENDPOINT_CRD:-true}" = "true" ]; then
        printf '%s\n' 'customresourcedefinition.apiextensions.k8s.io/dnsendpoints.externaldns.k8s.io'
      else
        return 1
      fi
      ;;
    *" get serviceaccount external-dns "*)
      printf '%s' "${OR_EKS_STACK_TEST_EXTERNAL_DNS_ROLE_ARN-arn:aws:iam::123456789012:role/openremote-external-dns}"
      ;;
    *" get dnsendpoint acm-validation "*)
      if [ -n "${OR_EKS_STACK_TEST_DNS_ENDPOINT_READ_ERROR:-}" ]; then
        printf '%s\n' "$OR_EKS_STACK_TEST_DNS_ENDPOINT_READ_ERROR" >&2
        return 1
      fi
      if [ -f "$NAMESPACE_DELETED_FILE" ]; then
        return 0
      fi
      if [ "${OR_EKS_STACK_TEST_DNS_ENDPOINT_EXISTS:-false}" != "true" ]; then
        [[ "$arguments" == *" --ignore-not-found "* ]] && return 0
        return 1
      fi
      printf '%s\n' "${OR_EKS_STACK_TEST_DNS_ENDPOINT_JSON-$DEFAULT_DNS_ENDPOINT_JSON}"
      ;;
    *" get dnsendpoint acm-validation-mqtts "*)
      if [ -n "${OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_READ_ERROR:-}" ]; then
        printf '%s\n' "$OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_READ_ERROR" >&2
        return 1
      fi
      [ "${OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_READ_SUCCESS:-true}" = true ] || return 1
      if [ -f "$NAMESPACE_DELETED_FILE" ]; then
        return 0
      fi
      if [ "${OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_EXISTS:-false}" != true ]; then
        [[ "$arguments" == *" --ignore-not-found "* ]] && return 0
        return 1
      fi
      printf '%s\n' "${OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_JSON-$DEFAULT_MQTTS_DNS_ENDPOINT_JSON}"
      ;;
    *" apply -f - "*)
      IFS= read -r endpoint_manifest
      printf '%s\n' "$endpoint_manifest" > "$DNS_ENDPOINT_LOG"
      ;;
    *" get service proxy-mqtts "*" -o json "*)
      [ "${OR_EKS_STACK_TEST_MQTTS_SERVICE_READ_SUCCESS:-true}" = true ] || return 1
      if [ "${OR_EKS_STACK_TEST_MQTTS_SERVICE_EXISTS:-true}" = true ] && \
         [ ! -f "$NAMESPACE_DELETED_FILE" ]; then
        printf '%s\n' "${OR_EKS_STACK_TEST_MQTTS_SERVICE_JSON-$DEFAULT_MQTTS_SERVICE_JSON}"
      fi
      ;;
    *" get service proxy-mqtts "*)
      printf '%s' "${OR_EKS_STACK_TEST_MQTTS_NLB_ADDRESS:-test-mqtt-nlb.elb.eu-west-1.amazonaws.com}"
      ;;
    *" get service proxy "*)
      printf '%s' "${OR_EKS_STACK_TEST_NLB_ADDRESS:-test-nlb.elb.eu-west-1.amazonaws.com}"
      ;;
    *" get ingress proxy "*" -o json "*)
      if [ "${OR_EKS_STACK_TEST_INGRESS_EXISTS:-false}" = "true" ] && \
         [ ! -f "$INGRESS_DELETED_FILE" ] && \
