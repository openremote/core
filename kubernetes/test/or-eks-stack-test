test_validation_dns_endpoint_read_safety() {
  local endpoint scenario apply_records endpoint_name failure_output read_error
  local OR_EKS_STACK_TEST_DNS_ENDPOINT_EXISTS
  local OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_EXISTS
  local OR_EKS_STACK_TEST_DNS_ENDPOINT_JSON
  local OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_JSON
  local OR_EKS_STACK_TEST_DNS_ENDPOINT_READ_ERROR
  local OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_READ_ERROR

  for endpoint in web mqtts; do
    apply_records=apply_managed_certificate_validation_records
    endpoint_name=acm-validation
    if [ "$endpoint" = mqtts ]; then
      apply_records=apply_managed_mqtts_certificate_validation_records
      endpoint_name=acm-validation-mqtts
    fi
    for scenario in absent owned unowned forbidden unavailable; do
      reset_test
      STACK_NAME=stack-a
      KUBE_CONTEXT=test-cluster@eu-west-1
      CERTIFICATE_ARN="$TEST_CERTIFICATE_ARN"
      MQTTS_CERTIFICATE_ARN="$TEST_MQTTS_CERTIFICATE_ARN"
      CERTIFICATE_JSON="$MANAGED_CERTIFICATE_JSON"
      MQTTS_CERTIFICATE_JSON="$MANAGED_MQTTS_CERTIFICATE_JSON"
      EXTERNAL_DNS_ARGS="$DEFAULT_EXTERNAL_DNS_ARGS"
      OR_EKS_STACK_TEST_DNS_ENDPOINT_EXISTS=true
      OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_EXISTS=true
      OR_EKS_STACK_TEST_DNS_ENDPOINT_JSON="$DEFAULT_DNS_ENDPOINT_JSON"
      OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_JSON="$DEFAULT_MQTTS_DNS_ENDPOINT_JSON"
      read_error=""
      case "$scenario" in
        absent)
          OR_EKS_STACK_TEST_DNS_ENDPOINT_EXISTS=false
          OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_EXISTS=false ;;
        unowned)
          OR_EKS_STACK_TEST_DNS_ENDPOINT_JSON='{"metadata":{"labels":{"app.kubernetes.io/managed-by":"someone-else"}}}'
          OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_JSON="$OR_EKS_STACK_TEST_DNS_ENDPOINT_JSON" ;;
        forbidden) read_error='Error from server (Forbidden): cannot get DNSEndpoint' ;;
        unavailable) read_error='Unable to connect to the server: connection refused' ;;
      esac
      OR_EKS_STACK_TEST_DNS_ENDPOINT_READ_ERROR="$read_error"
      OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_READ_ERROR="$read_error"
      case "$scenario" in
        absent|owned)
          "$apply_records" >/dev/null
          assert_contains $'apply\t-f\t-'
          [ "$(jq -r '.metadata.name' "$DNS_ENDPOINT_LOG")" = "$endpoint_name" ] || fail \
            "Did not write the expected $endpoint validation resource"
          ;;
        *)
          if failure_output="$("$apply_records" 2>&1)"; then
            fail "Validation records were applied after $scenario lookup for $endpoint"
          fi
          assert_not_contains $'apply\t-f\t-'
          if [ -n "$read_error" ]; then
            grep -F "$read_error" <<< "$failure_output" >/dev/null || fail "$failure_output"
            grep -F 'without ownership checks' <<< "$failure_output" >/dev/null || fail "$failure_output"
          else
            grep -F 'not owned' <<< "$failure_output" >/dev/null || fail "$failure_output"
          fi
          ;;
      esac
      assert_contains $'get\tdnsendpoint\t'"$endpoint_name"$'\t--ignore-not-found\t-o\tjson'
    done
  done
}

