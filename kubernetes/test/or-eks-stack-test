    fail "A one-level wildcard covered a multi-level hostname"
  fi
  assert_not_contains $'or-stack\tapply'

  if (OR_EKS_STACK_TEST_CERTIFICATE_TAGS='{"Tags":[{"Key":"openremote.io/managed-by","Value":"or-eks-stack"}]}' \
      run_eks_stack apply --name stack-a --cluster test-cluster \
        --hostname stack-a.example.com --exposure ingress \
        --certificate-mode existing --certificate-arn "$TEST_CERTIFICATE_ARN") \
      >/dev/null 2>&1; then
    fail "A stack-managed ACM certificate was accepted in existing mode"
  fi
  assert_not_contains $'or-stack\tapply'

  if (OR_EKS_STACK_TEST_SHARED_CERTIFICATE_ARN="$TEST_CERTIFICATE_ARN" \
      OR_EKS_STACK_TEST_CERTIFICATE_TAGS='{"Tags":[{"Key":"openremote.io/managed-by","Value":"or-eks-stack"}]}' \
      run_eks_stack apply --name stack-a --cluster test-cluster \
        --hostname stack-a.example.com --exposure ingress \
        --certificate-mode shared) >/dev/null 2>&1; then
    fail "A stack-managed ACM certificate was accepted in shared mode"
  fi
  assert_not_contains $'or-stack\tapply'

  if addresses_intersect '192.0.2.10' '198.51.100.20'; then
    fail "Unrelated stale and current load-balancer addresses matched"
  fi
  addresses_intersect $'192.0.2.10\n192.0.2.11' $'198.51.100.20\n192.0.2.11' || fail \
    "Matching hostname and load-balancer address sets were rejected"
}


test_hostname_reservation_lifecycle() {
  local exposure registry
  registry="$(jq -cn '{metadata:{resourceVersion:"1",labels:{"app.kubernetes.io/managed-by":"or-stack"}},
    data:{"stack-a.example.com":({namespace:"stack-a",namespaceUID:"uid-stack-a",target:"eks",dns:"external-dns",exposure:"haproxy"}|tojson)}}')"

  for exposure in haproxy ingress; do
    if (OR_EKS_STACK_TEST_PREPARE_FAIL=true run_eks_stack apply --name stack-a \
      --cluster test-cluster --hostname stack-a.example.com --exposure "$exposure" --profile '') >/dev/null 2>&1; then
      fail "Failed hostname reservation did not stop $exposure apply"
    fi
    assert_contains $'or-stack\tprepare'
    assert_contains $'--hostname\tstack-a.example.com'
    assert_not_contains $'aws-acm\trequest-certificate'
    assert_not_contains $'or-stack\tapply'
  done

  OR_EKS_STACK_TEST_REGISTRY_JSON="$registry" run_eks_stack destroy --name stack-a \
    --cluster test-cluster --confirm stack-a --profile '' >/dev/null
  assert_before $'or-stack\tdestroy' $'stack-a.example.com\tA'
  assert_before $'stack-a.example.com\tA' $'or-stack\trelease-hostname'

  OR_EKS_STACK_TEST_REGISTRY_JSON="$registry" OR_EKS_STACK_TEST_NAMESPACE_EXISTS=false \
    run_eks_stack destroy --name stack-a --cluster test-cluster --confirm stack-a --profile '' >/dev/null
  assert_not_contains $'or-stack\tdestroy'
  assert_contains $'or-stack\trelease-hostname'

  if (OR_EKS_STACK_TEST_REGISTRY_JSON="$registry" OR_EKS_STACK_TEST_DNS_STATUS=SERVFAIL \
    run_eks_stack destroy --name stack-a --cluster test-cluster --confirm stack-a \
      --profile '' --timeout 1s) >/dev/null 2>&1; then
    fail "Failed DNS confirmation released the hostname reservation"
  fi
  assert_not_contains $'or-stack\trelease-hostname'

  if (OR_EKS_STACK_TEST_REGISTRY_JSON="$registry" OR_EKS_STACK_TEST_DNS_FLAGS=qr \
    run_eks_stack destroy --name stack-a --cluster test-cluster --confirm stack-a \
      --profile '' --timeout 1s) >/dev/null 2>&1; then
    fail "Non-authoritative DNS confirmation released the hostname reservation"
  fi
  assert_not_contains $'or-stack\trelease-hostname'

  registry="$(jq '.data["stack-a.example.com"] |= (fromjson | .exposure="ingress" | tojson)' <<< "$registry")"
  OR_EKS_STACK_TEST_REGISTRY_JSON="$registry" test_managed_destroy
  assert_before $'aws-acm\tdelete-certificate' $'or-stack\trelease-hostname'
}

test_destroy_handles_incomplete_mqtts_lifecycle() {
  local failure_output
  local output hostname scenario expected_error
  local registry

  registry="$(jq -cn '{metadata:{resourceVersion:"1",labels:{"app.kubernetes.io/managed-by":"or-stack"}},
    data:{
      "stack-a.example.com":({namespace:"stack-a",namespaceUID:"uid-stack-a",target:"eks",dns:"external-dns",exposure:"ingress",endpoint:"web"}|tojson),
      "mqtt-stack-a.example.com":({namespace:"stack-a",namespaceUID:"uid-stack-a",target:"eks",dns:"external-dns",exposure:"ingress",endpoint:"mqtts"}|tojson)
    }}')"

  if failure_output="$(OR_EKS_STACK_TEST_REGISTRY_JSON="$registry" \
      run_eks_stack destroy --name stack-a --cluster test-cluster \
        --profile '' --confirm stack-a 2>&1)"; then
    fail "or-eks-stack destroy accepted a low-level Ingress MQTTS endpoint"
  fi
  grep -F -- 'low-level or unowned Ingress MQTTS endpoint' <<< "$failure_output" >/dev/null || fail "$failure_output"
  assert_not_contains $'or-stack\tdestroy'
  assert_not_contains $'or-stack\trelease-hostname'

  local OR_EKS_STACK_TEST_REGISTRY_JSON="$registry"
  local OR_EKS_STACK_TEST_MQTTS_SERVICE_EXISTS=false
  local OR_EKS_STACK_TEST_RECORDED_MQTTS_CERTIFICATE_MODE=""
  local OR_EKS_STACK_TEST_RECORDED_MQTTS_CERTIFICATE_ARN=""
  local OR_EKS_STACK_TEST_RECORDED_MQTTS_HOSTNAME=""
  local OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_EXISTS=false
  local OR_EKS_STACK_TEST_MQTTS_SERVICE_READ_SUCCESS=true
  local OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_READ_SUCCESS=true
  local OR_EKS_STACK_TEST_LOAD_BALANCERS_JSON=""
  local OR_EKS_STACK_TEST_DNS_STATUS=NOERROR

  # Interruption can occur just after the reservation write, or after prepare
  # has also annotated the hostname but before the facade records mode.
  for hostname in '' mqtt-stack-a.example.com; do
    OR_EKS_STACK_TEST_RECORDED_MQTTS_HOSTNAME="$hostname"
    output="$(run_eks_stack destroy --name stack-a --cluster test-cluster \
      --profile '' --confirm stack-a)"
    grep -F 'incomplete MQTTS prepare' <<< "$output" >/dev/null || fail "$output"
    assert_contains $'or-stack\tdestroy'
    assert_before $'get\tdnsendpoint\tacm-validation-mqtts' $'or-stack\tdestroy'
    assert_before $'aws-elbv2\tdescribe-load-balancers' $'or-stack\trelease-hostname'
    assert_before $'mqtt-stack-a.example.com\tA' $'or-stack\trelease-hostname'
    assert_contains $'--hostname\tmqtt-stack-a.example.com\t--confirm\tstack-a'
    assert_contains $'--hostname\tstack-a.example.com\t--confirm\tstack-a'
    assert_not_contains $'aws-acm\tdelete-certificate'
  done

  for scenario in certificate validation hostname mode service-read validation-read nlb dns; do
    OR_EKS_STACK_TEST_RECORDED_MQTTS_CERTIFICATE_MODE=""
    OR_EKS_STACK_TEST_RECORDED_MQTTS_CERTIFICATE_ARN=""
    OR_EKS_STACK_TEST_RECORDED_MQTTS_HOSTNAME=mqtt-stack-a.example.com
    OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_EXISTS=false
    OR_EKS_STACK_TEST_MQTTS_SERVICE_READ_SUCCESS=true
    OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_READ_SUCCESS=true
    OR_EKS_STACK_TEST_LOAD_BALANCERS_JSON=""
    OR_EKS_STACK_TEST_DNS_STATUS=NOERROR
    case "$scenario" in
      certificate)
        OR_EKS_STACK_TEST_RECORDED_MQTTS_CERTIFICATE_ARN="$TEST_MQTTS_CERTIFICATE_ARN"
        expected_error='low-level or unowned Ingress MQTTS endpoint' ;;
      validation)
        OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_EXISTS=true
        expected_error='MQTTS validation resources without a recorded certificate mode' ;;
      hostname)
        OR_EKS_STACK_TEST_RECORDED_MQTTS_HOSTNAME=other.example.com
        expected_error="but reserves 'mqtt-stack-a.example.com'" ;;
      mode)
        OR_EKS_STACK_TEST_RECORDED_MQTTS_CERTIFICATE_MODE=unsupported
        expected_error='low-level or unowned Ingress MQTTS endpoint' ;;
      service-read)
        OR_EKS_STACK_TEST_MQTTS_SERVICE_READ_SUCCESS=false
        expected_error="Unable to inspect Service 'stack-a/proxy-mqtts'" ;;
      validation-read)
        OR_EKS_STACK_TEST_MQTTS_DNS_ENDPOINT_READ_SUCCESS=false
        expected_error='Unable to inspect validation resources for the incomplete MQTTS configuration' ;;
      nlb)
        OR_EKS_STACK_TEST_LOAD_BALANCERS_JSON="$DEFAULT_LOAD_BALANCERS_JSON"
        expected_error='MQTTS NLB deletion' ;;
      dns)
        OR_EKS_STACK_TEST_DNS_STATUS=SERVFAIL
        expected_error='DNS' ;;
    esac
    if failure_output="$(run_eks_stack destroy --name stack-a --cluster test-cluster \
        --profile '' --confirm stack-a --timeout 1s 2>&1)"; then
      fail "Destroy accepted unsafe incomplete MQTTS cleanup ($scenario)"
    fi
    grep -F "$expected_error" <<< "$failure_output" >/dev/null || fail "$failure_output"
    case "$scenario" in
      nlb|dns) assert_contains $'or-stack\tdestroy' ;;
      *) assert_not_contains $'or-stack\tdestroy' ;;
    esac
    assert_not_contains $'or-stack\trelease-hostname'
    assert_not_contains $'aws-acm\tdelete-certificate'
  done
}

