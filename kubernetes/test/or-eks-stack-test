    *" delete ingress proxy "*)
      : > "$INGRESS_DELETED_FILE"
      ;;
    *" get ingress proxy "*)
      printf '%s' "${OR_EKS_STACK_TEST_ALB_ADDRESS:-test-alb.elb.eu-west-1.amazonaws.com}"
      ;;
    *" exec deployment/proxy "*" -- sh -c "*)
      [ "${OR_EKS_STACK_TEST_CERTIFICATE_INSPECTION_SUCCESS:-true}" = true ] || return 1
      # Execute the actual read-only probe against temporary persisted state.
      while [ "$1" != -- ]; do shift; done
      shift
      LE_DIR="$PROXY_LE_DIR" command "$@"
      ;;
    *" exec deployment/proxy "*" /entrypoint.sh add "*)
      if [ "${OR_EKS_STACK_TEST_STARTUP_ISSUES_CERTIFICATE:-false}" = true ]; then
        create_proxy_certificate
      fi
      [ "${OR_EKS_STACK_TEST_ACME_SUCCESS:-true}" = "true" ]
      ;;
  esac
}

dig() {
  local argument
  local authoritative=false
  local dns_name=""
  local record_type=""

  log_call dig "$@"
  for argument in "$@"; do
    case "$argument" in
      @*) authoritative=true ;;
      A|AAAA|CNAME|NS) record_type="$argument" ;;
      +*) ;;
      *) dns_name="$argument" ;;
    esac
  done

  if [ "$record_type" = "NS" ]; then
    [ "$dns_name" = "example.com" ] && printf '%s\n' 'ns-1.example.net.'
    return
  fi

  if [ "$authoritative" = true ]; then
    printf ';; ->>HEADER<<- opcode: QUERY, status: %s, id: 1\n' "${OR_EKS_STACK_TEST_DNS_STATUS:-NOERROR}"
    printf ';; flags: %s; QUERY: 1, ANSWER: 0, AUTHORITY: 1\n' "${OR_EKS_STACK_TEST_DNS_FLAGS:-qr aa}"
    [ "${OR_EKS_STACK_TEST_DNS_STATUS:-NOERROR}" = NOERROR ] || return 0
    case "$dns_name" in
      stack-a.example.com)
        if [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = true ] &&
           [ ! -f "$INGRESS_DELETED_FILE" ] && [ ! -f "$NAMESPACE_DELETED_FILE" ]; then
          printf '%s. 60 IN A 192.0.2.10\n' "$dns_name"
        fi
        ;;
      mqtt-stack-a.example.com)
        if [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = true ] && \
           [ ! -f "$NAMESPACE_DELETED_FILE" ]; then
          printf '%s. 60 IN A 192.0.2.20\n' "$dns_name"
        fi
        ;;
      _validation.stack-a.example.com|_validation.stack-a.example.com.)
        if [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = true ] && [ ! -f "$NAMESPACE_DELETED_FILE" ]; then
          printf '%s 300 IN CNAME _target.acm-validations.aws.\n' "$dns_name"
        fi
        ;;
      _validation.mqtt-stack-a.example.com|_validation.mqtt-stack-a.example.com.)
        if [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = true ] && \
           [ ! -f "$NAMESPACE_DELETED_FILE" ]; then
          printf '%s 300 IN CNAME _mqtt-target.acm-validations.aws.\n' "$dns_name"
        fi
        ;;
    esac
    return 0
  fi

  case "$dns_name" in
    stack-a.example.com)
      if [ "$authoritative" = false ] || \
         { [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = "true" ] && \
           [ ! -f "$INGRESS_DELETED_FILE" ]; }; then
        printf '%s\n' "${OR_EKS_STACK_TEST_HOST_ADDRESS:-192.0.2.10}"
      fi
      ;;
    mqtt-stack-a.example.com)
      if [ "$authoritative" = false ] || \
         { [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = "true" ] && \
           [ ! -f "$NAMESPACE_DELETED_FILE" ]; }; then
        printf '%s\n' "${OR_EKS_STACK_TEST_MQTTS_HOST_ADDRESS:-192.0.2.20}"
      fi
      ;;
    _validation.stack-a.example.com|_validation.stack-a.example.com.)
      if [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = "true" ] && \
         [ ! -f "$NAMESPACE_DELETED_FILE" ]; then
        printf '%s\n' '_target.acm-validations.aws.'
      fi
      ;;
    _validation.mqtt-stack-a.example.com|_validation.mqtt-stack-a.example.com.)
      if [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = true ] && \
         [ ! -f "$NAMESPACE_DELETED_FILE" ]; then
        printf '%s\n' '_mqtt-target.acm-validations.aws.'
      fi
      ;;
    test-nlb.elb.eu-west-1.amazonaws.com)
      printf '%s\n' "${OR_EKS_STACK_TEST_NLB_RESOLVED_ADDRESS:-192.0.2.10}"
      ;;
    test-alb.elb.eu-west-1.amazonaws.com)
      printf '%s\n' "${OR_EKS_STACK_TEST_ALB_RESOLVED_ADDRESS:-192.0.2.10}"
      ;;
    test-mqtt-nlb.elb.eu-west-1.amazonaws.com)
      printf '%s\n' "${OR_EKS_STACK_TEST_MQTTS_NLB_RESOLVED_ADDRESS:-192.0.2.20}"
      ;;
  esac
}

curl() {
  local curl_count

  log_call curl "$@"
  curl_count="$(< "$CURL_COUNT_FILE")"
  curl_count="$((curl_count + 1))"
  printf '%s\n' "$curl_count" > "$CURL_COUNT_FILE"
  [ "${OR_EKS_STACK_TEST_HTTPS_ALWAYS_FAILS:-false}" = false ] || return 1
  if [ "${OR_EKS_STACK_TEST_HTTPS_READY_IMMEDIATELY:-false}" = "true" ]; then
    return 0
  fi
  [ "$curl_count" -gt 1 ]
}

