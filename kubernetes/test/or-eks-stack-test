test_acme_state_and_readiness() {
  local failure_output

  # A transient Manager/network failure with persisted state must only retry
  # readiness; it must never issue or force-renew a certificate.
  OR_EKS_STACK_TEST_PROXY_CERTIFICATE_STATE=present \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com >/dev/null
  assert_not_contains $'/entrypoint.sh\tadd'
  assert_not_contains $'/entrypoint.sh\trenew'
  [ "$(< "$CURL_COUNT_FILE")" -eq 2 ] || fail "Apply did not retry HTTPS readiness"

  if failure_output="$(OR_EKS_STACK_TEST_PROXY_CERTIFICATE_STATE=present \
    OR_EKS_STACK_TEST_HTTPS_ALWAYS_FAILS=true \
      run_eks_stack apply --name stack-a --cluster test-cluster \
        --hostname stack-a.example.com --timeout 1s 2>&1)"; then
    fail "Apply accepted an unavailable HTTPS endpoint"
  fi
  grep -F 'Trusted HTTPS did not become ready' <<< "$failure_output" >/dev/null || fail \
    "Apply did not identify a readiness timeout"
  assert_not_contains $'/entrypoint.sh\tadd'
  assert_not_contains $'/entrypoint.sh\trenew'

  if failure_output="$(OR_EKS_STACK_TEST_PROXY_CERTIFICATE_STATE=incomplete \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com 2>&1)"; then
    fail "Apply accepted incomplete persisted certificate state"
  fi
  grep -F 'is incomplete' <<< "$failure_output" >/dev/null || fail "Missing incomplete-state diagnostic"
  assert_not_contains $'/entrypoint.sh\tadd'

  if failure_output="$(OR_EKS_STACK_TEST_CERTIFICATE_INSPECTION_SUCCESS=false \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com 2>&1)"; then
    fail "Apply treated a failed inspection as absent certificate state"
  fi
  grep -F 'Unable to inspect HAProxy certificate state' <<< "$failure_output" >/dev/null || fail \
    "Missing certificate inspection failure diagnostic"
  assert_not_contains $'/entrypoint.sh\tadd'

  # Startup can create the lineage between inspection and add. A failed add is
  # recoverable only with persisted files, and still requires trusted HTTPS.
  OR_EKS_STACK_TEST_STARTUP_ISSUES_CERTIFICATE=true OR_EKS_STACK_TEST_ACME_SUCCESS=false \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com >/dev/null
  assert_contains $'/entrypoint.sh\tadd'
  assert_contains $'curl\t'

  if failure_output="$(OR_EKS_STACK_TEST_ACME_SUCCESS=false \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com 2>&1)"; then
    fail "Apply ignored failed issuance without persisted certificate state"
  fi
  grep -F 'HAProxy ACME issuance failed (certificate state: absent)' <<< "$failure_output" >/dev/null || fail \
    "Missing issuance failure diagnostic"
  assert_not_contains $'curl\t'

  if failure_output="$(OR_EKS_STACK_TEST_HTTPS_READY_IMMEDIATELY=true \
    OR_EKS_STACK_TEST_MQTTS_ALWAYS_FAILS=true \
      run_eks_stack apply --name stack-a --cluster test-cluster \
        --hostname stack-a.example.com --mqtts --timeout 1s 2>&1)"; then
    fail "Apply accepted an unavailable MQTTS endpoint"
  fi
  grep -F 'Trusted MQTTS did not become ready' <<< "$failure_output" >/dev/null || fail \
    "Apply did not identify an MQTTS readiness timeout"
  assert_contains $'python3\t-\tstack-a.example.com\t8883\t1'
}

