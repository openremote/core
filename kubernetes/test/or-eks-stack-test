test_persistent_certificate_modes() {
  local recorded_mode recorded_arn requested_mode failure_output registry
  local mode_args=()

  # First apply defaults to managed; adding a shared certificate must not
  # change the persisted mode or ARN when the original command is repeated.
  OR_EKS_STACK_TEST_NAMESPACE_EXISTS=false \
  OR_EKS_STACK_TEST_CERTIFICATE_JSON="$MANAGED_CERTIFICATE_JSON" \
  OR_EKS_STACK_TEST_CERTIFICATE_TAGS="$MANAGED_CERTIFICATE_TAGS" \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com --exposure ingress >/dev/null
  recorded_mode="$(jq -r '.metadata.annotations["openremote.io/certificate-mode"]' "$CERTIFICATE_NAMESPACE_FILE")"
  recorded_arn="$(jq -r '.metadata.annotations["openremote.io/certificate-arn"]' "$CERTIFICATE_NAMESPACE_FILE")"
  [ "$recorded_mode" = managed ] && [ "$recorded_arn" = "$TEST_CERTIFICATE_ARN" ] || fail "Initial managed mode was not recorded"

  OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_MODE="$recorded_mode" \
  OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_ARN="$recorded_arn" \
  OR_EKS_STACK_TEST_SHARED_CERTIFICATE_ARN="$TEST_SECOND_CERTIFICATE_ARN" \
  OR_EKS_STACK_TEST_CERTIFICATE_JSON="$MANAGED_CERTIFICATE_JSON" \
  OR_EKS_STACK_TEST_CERTIFICATE_TAGS="$MANAGED_CERTIFICATE_TAGS" \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com --exposure ingress >/dev/null
  assert_not_contains $'get\tingressclass\topenremote-alb'
  assert_not_contains $'aws-acm\trequest-certificate'
  assert_contains $'--certificate-arn\t'"$TEST_CERTIFICATE_ARN"
  jq -e '.metadata.annotations["openremote.io/certificate-mode"] == "managed"' \
    "$CERTIFICATE_NAMESPACE_FILE" >/dev/null || fail "Reapply changed managed mode"
  # A remains normally destroyable even while B is the cluster default.
  OR_EKS_STACK_TEST_SHARED_CERTIFICATE_ARN="$TEST_SECOND_CERTIFICATE_ARN" test_managed_destroy

  for recorded_mode in managed existing shared; do
    for requested_mode in managed existing shared; do
      [ "$recorded_mode" != "$requested_mode" ] || continue
      mode_args=(--certificate-mode "$requested_mode")
      if [ "$requested_mode" = existing ]; then
        mode_args+=(--certificate-arn "$TEST_SECOND_CERTIFICATE_ARN")
      fi
      if failure_output="$(OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_MODE="$recorded_mode" \
        OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_ARN="$TEST_CERTIFICATE_ARN" \
        OR_EKS_STACK_TEST_SHARED_CERTIFICATE_ARN="$TEST_SECOND_CERTIFICATE_ARN" \
          run_eks_stack apply --name stack-a --cluster test-cluster \
            --hostname stack-a.example.com --exposure ingress "${mode_args[@]}" 2>&1)"; then
        fail "Accepted mode migration from $recorded_mode to $requested_mode"
      fi
      grep -F 'in-place certificate mode migration' <<< "$failure_output" >/dev/null || fail "$failure_output"
      assert_not_contains $'or-stack\tprepare'
      assert_not_contains $'annotate\tnamespace'
      assert_not_contains $'aws-acm\trequest-certificate'
    done
  done

  # Existing mode can reuse its recorded ARN, or explicitly rotate within mode.
  OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_MODE=existing \
  OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_ARN="$TEST_CERTIFICATE_ARN" \
  OR_EKS_STACK_TEST_SHARED_CERTIFICATE_ARN="$TEST_SECOND_CERTIFICATE_ARN" \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com --exposure ingress >/dev/null
  assert_contains $'--certificate-arn\t'"$TEST_CERTIFICATE_ARN"
  assert_not_contains $'get\tingressclass\topenremote-alb'

  OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_MODE=existing \
  OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_ARN="$TEST_CERTIFICATE_ARN" \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com --exposure ingress \
      --certificate-mode existing --certificate-arn "$TEST_SECOND_CERTIFICATE_ARN" >/dev/null
  assert_contains $'--certificate-arn\t'"$TEST_SECOND_CERTIFICATE_ARN"
  assert_not_contains $'aws-acm\trequest-certificate'

  OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_MODE=shared \
  OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_ARN="$TEST_CERTIFICATE_ARN" \
  OR_EKS_STACK_TEST_SHARED_CERTIFICATE_ARN="$TEST_SECOND_CERTIFICATE_ARN" \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com --exposure ingress >/dev/null
  assert_contains $'--certificate-arn\t'"$TEST_SECOND_CERTIFICATE_ARN"
  assert_not_contains $'aws-acm\trequest-certificate'

  if failure_output="$(OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_MODE=shared \
    OR_EKS_STACK_TEST_SHARED_CERTIFICATE_ARN='' \
      run_eks_stack apply --name stack-a --cluster test-cluster \
        --hostname stack-a.example.com --exposure ingress 2>&1)"; then
    fail "Shared mode fell back to managed after cluster configuration was removed"
  fi
  grep -F 'shared requires a certificate configured' <<< "$failure_output" >/dev/null || fail "$failure_output"
  assert_not_contains $'or-stack\tprepare'
  assert_not_contains $'aws-acm\trequest-certificate'

  # Interruption between pinning the mode and recording the ACM ARN resumes
  # using discovery, even if the cluster's default has changed meanwhile.
  OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_MODE=managed \
  OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_ARN='' \
  OR_EKS_STACK_TEST_SHARED_CERTIFICATE_ARN="$TEST_SECOND_CERTIFICATE_ARN" \
  OR_EKS_STACK_TEST_CERTIFICATE_LIST="{\"CertificateSummaryList\":[{\"CertificateArn\":\"$TEST_CERTIFICATE_ARN\",\"DomainName\":\"stack-a.example.com\"}]}" \
  OR_EKS_STACK_TEST_CERTIFICATE_JSON="$MANAGED_CERTIFICATE_JSON" \
  OR_EKS_STACK_TEST_CERTIFICATE_TAGS="$MANAGED_CERTIFICATE_TAGS" \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com --exposure ingress >/dev/null
  assert_contains $'aws-acm\tlist-certificates'
  assert_not_contains $'aws-acm\trequest-certificate'

  if (OR_EKS_STACK_TEST_NAMESPACE_READ_SUCCESS=false \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com --exposure ingress) >/dev/null 2>&1; then
    fail "Namespace read error was treated as absent certificate metadata"
  fi
  assert_not_contains $'or-stack\tprepare'

  if (OR_EKS_STACK_TEST_MODE_CONFLICT=true \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com --exposure ingress --certificate-mode managed) >/dev/null 2>&1; then
    fail "Mode reservation conflict did not stop apply"
  fi
  assert_contains '--resource-version=1'
  assert_not_contains $'aws-acm\trequest-certificate'
  assert_not_contains $'or-stack\tapply'

  if (OR_EKS_STACK_TEST_ACM_REQUEST_FAIL=true \
    run_eks_stack apply --name stack-a --cluster test-cluster \
      --hostname stack-a.example.com --exposure ingress --certificate-mode managed) >/dev/null 2>&1; then
    fail "Failed ACM request did not stop apply"
  fi
  jq -e '.metadata.annotations["openremote.io/certificate-mode"] == "managed" and
    ((.metadata.annotations["openremote.io/certificate-arn"] // "") == "")' \
    "$CERTIFICATE_NAMESPACE_FILE" >/dev/null || fail "Failed ACM request lost the initial mode"
  assert_not_contains $'or-stack\tapply'

  registry="$(jq -cn '{metadata:{resourceVersion:"1",labels:{"app.kubernetes.io/managed-by":"or-stack"}},
    data:{"stack-a.example.com":({namespace:"stack-a",namespaceUID:"uid-stack-a",target:"eks",dns:"external-dns",exposure:"ingress"}|tojson)}}')"
  OR_EKS_STACK_TEST_REGISTRY_JSON="$registry" \
  OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_MODE=managed \
  OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_ARN='' \
    run_eks_stack destroy --name stack-a --cluster test-cluster --confirm stack-a >/dev/null
  assert_contains $'or-stack\tdestroy'
  assert_contains $'or-stack\trelease-hostname'
  assert_not_contains $'aws-acm\tdelete-certificate'

  if (OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_MODE=managed \
    OR_EKS_STACK_TEST_DNS_ENDPOINT_EXISTS=true \
    run_eks_stack destroy --name stack-a --cluster test-cluster --confirm stack-a) >/dev/null 2>&1; then
    fail "Destroy accepted validation records without an identifiable certificate"
  fi
  assert_not_contains $'or-stack\tdestroy'
}


