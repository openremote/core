capture_mqtts_validation_dns_records_for_destroy() {
  local certificate_records_json='[]'
  local endpoint_certificate_arn
  local endpoint_kind
  local endpoint_managed_by
  local endpoint_managed_dns
  local endpoint_records_json='[]'
  local validation_endpoint=""

  MQTTS_VALIDATION_DNS_ENDPOINT_EXISTS=false
  MQTTS_VALIDATION_DNS_RECORDS=""
  if [ "$MQTTS_CERTIFICATE_EXISTS" = true ]; then
    certificate_records_json="$(jq -c \
      '[.Certificate.DomainValidationOptions[]?.ResourceRecord |
        select((.Name // "") != "" and (.Type // "") != "" and
               (.Value // "") != "") | {
          dnsName: .Name,
          recordType: .Type,
          targets: [.Value]
        }] | unique_by(.dnsName, .recordType, .targets[0]) |
        sort_by(.dnsName, .recordType, .targets[0])' \
      <<< "$MQTTS_CERTIFICATE_JSON")" || die \
        "Unable to read validation records from managed MQTTS certificate '$MQTTS_CERTIFICATE_ARN'."
  fi

  if [ "$STACK_NAMESPACE_EXISTS" = true ]; then
    validation_endpoint="$(kubectl --context "$KUBE_CONTEXT" \
      --namespace "$STACK_NAME" \
      get dnsendpoint "$ACM_MQTTS_VALIDATION_DNS_ENDPOINT_NAME" \
      --ignore-not-found -o json)" || die \
        "Unable to inspect DNSEndpoint '$STACK_NAME/$ACM_MQTTS_VALIDATION_DNS_ENDPOINT_NAME' before destroy."
  fi

  if [ -n "$validation_endpoint" ]; then
    MQTTS_VALIDATION_DNS_ENDPOINT_EXISTS=true
    endpoint_managed_by="$(jq -r \
      '.metadata.labels["app.kubernetes.io/managed-by"] // empty' \
      <<< "$validation_endpoint")"
    endpoint_managed_dns="$(jq -r \
      '.metadata.labels["openremote.io/managed-dns"] // empty' \
      <<< "$validation_endpoint")"
    endpoint_certificate_arn="$(jq -r \
      '.metadata.annotations["openremote.io/certificate-arn"] // empty' \
      <<< "$validation_endpoint")"
    endpoint_kind="$(jq -r \
      '.metadata.annotations["openremote.io/endpoint"] // empty' \
      <<< "$validation_endpoint")"
    [ "$endpoint_managed_by" = "$CERTIFICATE_MANAGED_BY_TAG_VALUE" ] && \
      [ "$endpoint_managed_dns" = true ] && \
      [ "$endpoint_certificate_arn" = "$MQTTS_CERTIFICATE_ARN" ] && \
      [ "$endpoint_kind" = mqtts ] || die \
        "DNSEndpoint '$STACK_NAME/$ACM_MQTTS_VALIDATION_DNS_ENDPOINT_NAME' does not exactly match managed MQTTS certificate '$MQTTS_CERTIFICATE_ARN'; refusing to delete it."

    endpoint_records_json="$(jq -c \
      '[.spec.endpoints[]? | {
        dnsName: (.dnsName // ""),
        recordType: (.recordType // ""),
        targets: ((.targets // []) | sort)
      }] | unique_by(.dnsName, .recordType, .targets[0]) |
      sort_by(.dnsName, .recordType, .targets[0])' \
      <<< "$validation_endpoint")" || die \
        "Unable to read records from DNSEndpoint '$STACK_NAME/$ACM_MQTTS_VALIDATION_DNS_ENDPOINT_NAME'."
    [ "$(jq 'length' <<< "$endpoint_records_json")" -gt 0 ] || die \
      "DNSEndpoint '$STACK_NAME/$ACM_MQTTS_VALIDATION_DNS_ENDPOINT_NAME' has no validation records."
    if [ "$MQTTS_CERTIFICATE_EXISTS" = true ] && \
       [ "$endpoint_records_json" != "$certificate_records_json" ]; then
      die "DNSEndpoint '$STACK_NAME/$ACM_MQTTS_VALIDATION_DNS_ENDPOINT_NAME' does not contain exactly the records returned by ACM; refusing destructive cleanup."
    fi
  elif [ "$MQTTS_CERTIFICATE_EXISTS" = false ]; then
    die "Managed MQTTS certificate '$MQTTS_CERTIFICATE_ARN' and its validation DNSEndpoint are both absent; validation-record ownership cannot be verified."
  fi

  if [ "$MQTTS_VALIDATION_DNS_ENDPOINT_EXISTS" = true ]; then
    MQTTS_VALIDATION_DNS_RECORDS="$(jq -r \
      '.[] | [.dnsName, .recordType] | @tsv' \
      <<< "$endpoint_records_json")"
  else
    MQTTS_VALIDATION_DNS_RECORDS="$(jq -r \
      '.[] | [.dnsName, .recordType] | @tsv' \
      <<< "$certificate_records_json")"
  fi

  while IFS=$'\t' read -r record_name record_type; do
    [ -n "$record_name" ] || continue
    [ "$record_type" = CNAME ] || die \
      "Managed MQTTS validation record '$record_name' has unsupported type '$record_type'."
    validation_record_is_in_managed_domain "$record_name" || die \
      "Managed MQTTS validation record '$record_name' is outside the configured ExternalDNS domains."
  done <<< "$MQTTS_VALIDATION_DNS_RECORDS"
}

