#!/usr/bin/env bash

# AWS-aware orchestration for an OpenRemote stack on an existing EKS cluster.
# Namespace-scoped Kubernetes resources remain owned by the portable or-stack
# command; this facade validates shared EKS services and coordinates endpoint
# readiness around it.

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/lib/hostname-reservations"

DEFAULT_AWS_REGION="eu-west-1"
DEFAULT_TIMEOUT="20m"
EXTERNAL_DNS_RELEASE_NAME="openremote-external-dns"
EXTERNAL_DNS_SERVICE_ACCOUNT_NAME="external-dns"
CERTIFICATE_MANAGED_BY_TAG_KEY="openremote.io/managed-by"
CERTIFICATE_MANAGED_BY_TAG_VALUE="or-eks-stack"
CERTIFICATE_CLUSTER_TAG_KEY="openremote.io/cluster"
CERTIFICATE_STACK_TAG_KEY="openremote.io/stack"
CERTIFICATE_HOSTNAME_TAG_KEY="openremote.io/hostname"
CERTIFICATE_ENDPOINT_TAG_KEY="openremote.io/endpoint"
CERTIFICATE_MODE_ANNOTATION="openremote.io/certificate-mode"
CERTIFICATE_ARN_ANNOTATION="openremote.io/certificate-arn"
HOSTNAME_ANNOTATION="openremote.io/hostname"
MQTTS_CERTIFICATE_MODE_ANNOTATION="openremote.io/mqtts-certificate-mode"
MQTTS_CERTIFICATE_ARN_ANNOTATION="openremote.io/mqtts-certificate-arn"
MQTTS_HOSTNAME_ANNOTATION="openremote.io/mqtts-hostname"
SHARED_CERTIFICATE_ARN_ANNOTATION="openremote.io/shared-certificate-arn"
ACM_VALIDATION_DNS_ENDPOINT_NAME="acm-validation"
ACM_MQTTS_VALIDATION_DNS_ENDPOINT_NAME="acm-validation-mqtts"

COMMAND=""
STACK_NAME="${OR_EKS_STACK_NAME:-}"
CLUSTER_NAME="${OR_EKS_STACK_CLUSTER:-}"
AWS_REGION_NAME="${OR_EKS_STACK_AWS_REGION:-${AWS_REGION:-$DEFAULT_AWS_REGION}}"
# Only --profile selects an explicit profile; otherwise leave credential
# resolution to AWS, including its standard environment settings.
AWS_PROFILE_NAME=""
KUBE_CONTEXT="${OR_EKS_STACK_KUBE_CONTEXT:-}"
EXPOSURE="${OR_EKS_STACK_EXPOSURE:-haproxy}"
HOSTNAME_VALUE="${OR_EKS_STACK_HOSTNAME:-}"
CERTIFICATE_MODE="${OR_EKS_STACK_CERTIFICATE_MODE:-}"
CERTIFICATE_ARN="${OR_EKS_STACK_CERTIFICATE_ARN:-}"
VALUES_DIR="${OR_EKS_STACK_VALUES_DIR:-}"
TIMEOUT="${OR_EKS_STACK_TIMEOUT:-$DEFAULT_TIMEOUT}"
HTTP_PORT="${OR_EKS_STACK_HTTP_PORT:-80}"
HTTPS_PORT="${OR_EKS_STACK_HTTPS_PORT:-443}"
MQTTS_ENABLED="${OR_EKS_STACK_MQTTS:-false}"
MQTTS_PORT="${OR_EKS_STACK_MQTTS_PORT:-8883}"
MQTTS_PORT_CONFIGURED=false
MQTTS_HOSTNAME_VALUE="${OR_EKS_STACK_MQTTS_HOSTNAME:-}"
MQTTS_CERTIFICATE_MODE="${OR_EKS_STACK_MQTTS_CERTIFICATE_MODE:-}"
MQTTS_CERTIFICATE_ARN="${OR_EKS_STACK_MQTTS_CERTIFICATE_ARN:-}"
CONFIRM_STACK_NAME=""
OR_STACK_COMMAND="${OR_EKS_STACK_OR_STACK:-$SCRIPT_DIR/or-stack}"
LOAD_BALANCER_ADDRESS=""
MQTTS_LOAD_BALANCER_ADDRESS=""
EXTERNAL_DNS_ARGS=""
CERTIFICATE_JSON=""
CERTIFICATE_EXISTS=false
MQTTS_CERTIFICATE_JSON=""
MQTTS_CERTIFICATE_EXISTS=false
STACK_NAMESPACE_EXISTS=false
VALIDATION_DNS_RECORDS=""
MQTTS_VALIDATION_DNS_RECORDS=""
MANAGED_DNS_DOMAIN=""
AUTHORITATIVE_NAME_SERVERS=""
STACK_INGRESS_JSON=""
STACK_MQTTS_SERVICE_JSON=""
VALIDATION_DNS_ENDPOINT_EXISTS=false
MQTTS_VALIDATION_DNS_ENDPOINT_EXISTS=false
MANAGED_CERTIFICATE_DESTROY=false
MANAGED_MQTTS_CERTIFICATE_DESTROY=false

if [ "${OR_EKS_STACK_MQTTS_PORT+x}" = "x" ]; then
  MQTTS_PORT_CONFIGURED=true
fi

usage() {
  cat <<'EOF'
Manage an OpenRemote stack on an existing Amazon EKS cluster.

Usage:
  or-eks-stack apply --name <name> --cluster <cluster> --hostname <host> [options]
  or-eks-stack status --name <name> --cluster <cluster> [options]
  or-eks-stack credentials --name <name> --cluster <cluster> [options]
  or-eks-stack uninstall --name <name> --cluster <cluster> [options]
  or-eks-stack destroy --name <name> --cluster <cluster> --confirm <name> [options]

Commands:
  apply                 Install or upgrade the stack, wait for its load balancer
                        and DNS, resolve TLS, and verify trusted HTTPS and any
                        enabled MQTTS endpoint.
  status                Show the stack's Kubernetes status.
  credentials           Show the Manager administrator login credentials.
  uninstall             Remove workloads while retaining namespace, credentials,
                        PVCs, and certificate state.
  destroy               Delete the stack namespace and its data after exact-name
                        confirmation.

Options:
  --name <name>         Stack and namespace name. Env: OR_EKS_STACK_NAME.
  --cluster <name>      Existing EKS cluster name. Env: OR_EKS_STACK_CLUSTER.
  --region <region>     AWS region. Env: OR_EKS_STACK_AWS_REGION.
                        Default: eu-west-1.
  --profile <name>      Explicit AWS profile. Default: no profile argument;
                        use the normal AWS credential chain. An empty value
                        also leaves profile selection to AWS.
  --kube-context <c>    Kubernetes context. Defaults to <cluster>@<region>.
                        Env: OR_EKS_STACK_KUBE_CONTEXT.
  --exposure <mode>     Public exposure: haproxy or ingress. Env:
                        OR_EKS_STACK_EXPOSURE. Default: haproxy.
  --hostname <host>     Public, ExternalDNS-managed hostname. Required by apply.
                        Must be a strict subdomain of a managed DNS domain.
                        Env: OR_EKS_STACK_HOSTNAME.
  --certificate-mode <mode>
                        Certificate ownership mode for Ingress: existing,
                        shared, or managed. Reapply preserves the recorded mode.
                        On first selection, omission chooses a configured shared
                        certificate, otherwise managed. In-place mode migration
                        is not supported. Env:
                        OR_EKS_STACK_CERTIFICATE_MODE.
  --certificate-arn <arn>
                        Existing ACM ARN for mode existing; reapply can omit it
                        to reuse the recorded ARN. Env:
                        OR_EKS_STACK_CERTIFICATE_ARN. Mode shared reads the ARN
                        from the cluster's openremote-alb IngressClass.
  --http-port <port>    Public HAProxy Service HTTP port. Env:
                        OR_EKS_STACK_HTTP_PORT. HAProxy only; must remain 80 for
                        automated HTTP-01 certificate issuance.
  --https-port <port>   Public HAProxy Service HTTPS port. Env:
                        OR_EKS_STACK_HTTPS_PORT. HAProxy only; default: 443.
  --mqtts               Expose MQTTS. HAProxy uses the web hostname and its
                        own certificate; Ingress uses a dedicated NLB,
                        hostname, and ACM certificate. Env:
                        OR_EKS_STACK_MQTTS. Default: false. Plaintext MQTT is
                        not exposed.
  --mqtts-port <port>   Public MQTTS port. Env: OR_EKS_STACK_MQTTS_PORT.
                        Default: 8883. Requires --mqtts.
  --mqtts-hostname <host>
                        Dedicated ExternalDNS-managed hostname for Ingress
                        MQTTS. Required on first apply; reapply may reuse the
                        recorded hostname. Env: OR_EKS_STACK_MQTTS_HOSTNAME.
  --mqtts-certificate-mode <mode>
                        Certificate ownership mode for Ingress MQTTS: existing,
                        shared, or managed. An explicit ARN implies existing;
                        otherwise first apply selects the cluster's configured
                        shared certificate, falling back to managed. Reapply
                        preserves the recorded mode. Env:
                        OR_EKS_STACK_MQTTS_CERTIFICATE_MODE.
  --mqtts-certificate-arn <arn>
                        Existing ACM certificate for the Ingress MQTTS NLB in
                        mode existing. Reapply may reuse the recorded ARN. Env:
                        OR_EKS_STACK_MQTTS_CERTIFICATE_ARN.
  --values-dir <path>   Optional per-component values directory passed to
                        or-stack. Env: OR_EKS_STACK_VALUES_DIR.
  --timeout <duration>  Timeout used by Helm and each endpoint readiness phase.
                        Accepts seconds or an s, m, or h suffix. Env:
                        OR_EKS_STACK_TIMEOUT. Default: 20m.
  --confirm <name>      Required exact stack name for destroy.
  -h, --help            Show this help.

This is an AWS-aware facade over or-stack. It requires the OpenRemote-managed
ExternalDNS release installed by or-eks-cluster, with active Route 53 writes
for the requested hostname. The portable or-stack command remains available
for local clusters, unmanaged DNS, and internal-only stacks.

Before workloads or ACM requests, the facade prepares the namespace and reserves
its hostname through or-stack. A hostname cannot belong to two stacks or change
on an existing stack. Reservations survive uninstall and failed operations;
destroy releases them only after external cleanup. See kubernetes/README.md for
registry permissions, required stack metadata, and manual recovery. Destroy
requires a hostname reservation in every mode; missing state is an error and
never bypasses DNS cleanup.

Ingress accepts an explicit existing ACM ARN, the externally managed shared
certificate configured by or-eks-cluster, or a stack-owned managed certificate.
Managed mode requests or reuses an exact-hostname ACM certificate and retains
its namespaced DNS-validation record through uninstall. Destroy removes the
stack route and namespace, waits for its public and validation DNS records to
disappear, then deletes only the exactly owned ACM certificate.
Managed mode requires exclusive use of the certificate and its validation
records by this stack. Other certificates must not depend on those records;
this deployment requirement is not established by the script's ownership checks.
The first certificate mode is retained across failed applies and uninstall.
Changing mode requires destroying and recreating the stack; back up any data
to retain first. Certificate rotation within existing or shared mode is supported.
Ingress MQTTS accepts an existing user-owned ACM certificate, the cluster's
externally managed shared certificate, or a dedicated stack-managed
certificate. Managed mode owns a separate ACM certificate and DNS-validation
resource for the MQTTS endpoint; destroy deletes only that exactly tagged
certificate after the NLB and validation records are removed.
EOF
}

log() {
  printf '[or-eks-stack] %s\n' "$*"
}

warn() {
  printf '[or-eks-stack] WARNING: %s\n' "$*" >&2
}

die() {
  printf '[or-eks-stack] ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die \
    "Required command '$1' was not found in PATH."
}

aws_cli() {
  if [ -n "$AWS_PROFILE_NAME" ]; then
    aws "$@" --region "$AWS_REGION_NAME" --profile "$AWS_PROFILE_NAME"
  else
    aws "$@" --region "$AWS_REGION_NAME"
  fi
}

aws_eks() {
  aws_cli eks "$@"
}

aws_acm() {
  aws_cli acm "$@"
}

aws_elbv2() {
  aws_cli elbv2 "$@"
}

aws_sts() {
  aws_cli sts "$@"
}

run_or_stack() {
  "$OR_STACK_COMMAND" "$@"
}

parse_arguments() {
  if [ "$#" -eq 0 ]; then
    usage >&2
    exit 1
  fi

  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    apply|status|credentials|uninstall|destroy)
      COMMAND="$1"
      shift
      ;;
    *)
      die "Unknown command '$1'. Run with --help for usage."
      ;;
  esac

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        [ "$#" -ge 2 ] || die "Option --name requires a value."
        STACK_NAME="$2"
        shift 2
        ;;
      --cluster)
        [ "$#" -ge 2 ] || die "Option --cluster requires a value."
        CLUSTER_NAME="$2"
        shift 2
        ;;
      --region)
        [ "$#" -ge 2 ] || die "Option --region requires a value."
        AWS_REGION_NAME="$2"
        shift 2
        ;;
      --profile)
        [ "$#" -ge 2 ] || die "Option --profile requires a value."
        AWS_PROFILE_NAME="$2"
        shift 2
        ;;
      --kube-context)
        [ "$#" -ge 2 ] || die "Option --kube-context requires a value."
        KUBE_CONTEXT="$2"
        shift 2
        ;;
      --exposure)
        [ "$#" -ge 2 ] || die "Option --exposure requires a value."
        EXPOSURE="$2"
        shift 2
        ;;
      --hostname)
        [ "$#" -ge 2 ] || die "Option --hostname requires a value."
        HOSTNAME_VALUE="$2"
        shift 2
        ;;
      --certificate-mode)
        [ "$#" -ge 2 ] || die "Option --certificate-mode requires a value."
        CERTIFICATE_MODE="$2"
        shift 2
        ;;
      --certificate-arn)
        [ "$#" -ge 2 ] || die "Option --certificate-arn requires a value."
        CERTIFICATE_ARN="$2"
        shift 2
        ;;
      --http-port)
        [ "$#" -ge 2 ] || die "Option --http-port requires a value."
        HTTP_PORT="$2"
        shift 2
        ;;
      --https-port)
        [ "$#" -ge 2 ] || die "Option --https-port requires a value."
        HTTPS_PORT="$2"
        shift 2
        ;;
      --mqtts)
        MQTTS_ENABLED=true
        shift
        ;;
      --mqtts-port)
        [ "$#" -ge 2 ] || die "Option --mqtts-port requires a value."
        MQTTS_PORT="$2"
        MQTTS_PORT_CONFIGURED=true
        shift 2
        ;;
      --mqtts-hostname)
        [ "$#" -ge 2 ] || die "Option --mqtts-hostname requires a value."
        MQTTS_HOSTNAME_VALUE="$2"
        shift 2
        ;;
      --mqtts-certificate-mode)
        [ "$#" -ge 2 ] || die "Option --mqtts-certificate-mode requires a value."
        MQTTS_CERTIFICATE_MODE="$2"
        shift 2
        ;;
      --mqtts-certificate-arn)
        [ "$#" -ge 2 ] || die "Option --mqtts-certificate-arn requires a value."
        MQTTS_CERTIFICATE_ARN="$2"
        shift 2
        ;;
      --values-dir)
        [ "$#" -ge 2 ] || die "Option --values-dir requires a value."
        VALUES_DIR="$2"
        shift 2
        ;;
      --timeout)
        [ "$#" -ge 2 ] || die "Option --timeout requires a value."
        TIMEOUT="$2"
        shift 2
        ;;
      --confirm)
        [ "$#" -ge 2 ] || die "Option --confirm requires a value."
        CONFIRM_STACK_NAME="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown option '$1'. Run with --help for usage."
        ;;
    esac
  done
}

validate_stack_name() {
  [ -n "$STACK_NAME" ] || die "A stack name is required; use --name."
  [ "${#STACK_NAME}" -le 63 ] || die \
    "Stack name must contain at most 63 characters."
  if [[ ! "$STACK_NAME" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]]; then
    die "Stack name must be a lowercase Kubernetes namespace name."
  fi

  case "$STACK_NAME" in
    default|kube-system|kube-public|kube-node-lease)
      die "Namespace '$STACK_NAME' is reserved and cannot be used as a stack name."
      ;;
  esac
}

validate_cluster_name() {
  [ -n "$CLUSTER_NAME" ] || die "An EKS cluster name is required; use --cluster."
  [ "${#CLUSTER_NAME}" -le 100 ] || die \
    "EKS cluster name must contain at most 100 characters."
  if [[ ! "$CLUSTER_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; then
    die "EKS cluster name may contain only letters, numbers, underscores, and hyphens."
  fi
}

validate_port() {
  local port="$1"
  local name="$2"

  [[ "$port" =~ ^[0-9]+$ ]] || die \
    "$name port must be a number from 1 to 65535."
  [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die \
    "$name port must be a number from 1 to 65535."
}

duration_seconds() {
  local duration="$1"
  local multiplier

  if [[ ! "$duration" =~ ^([0-9]+)([smh]?)$ ]]; then
    return 1
  fi

  case "${BASH_REMATCH[2]}" in
    ""|s) multiplier=1 ;;
    m) multiplier=60 ;;
    h) multiplier=3600 ;;
    *) return 1 ;;
  esac

  printf '%s\n' "$((10#${BASH_REMATCH[1]} * multiplier))"
}

validate_common_options() {
  local timeout_seconds

  validate_stack_name
  validate_cluster_name
  [ -n "$AWS_REGION_NAME" ] || die "AWS region cannot be empty."
  if [ -z "$KUBE_CONTEXT" ]; then
    KUBE_CONTEXT="${CLUSTER_NAME}@${AWS_REGION_NAME}"
  fi
  [ -n "$KUBE_CONTEXT" ] || die "Kubernetes context cannot be empty."
  if ! timeout_seconds="$(duration_seconds "$TIMEOUT")"; then
    die "Timeout must be seconds or a duration with an s, m, or h suffix."
  fi
  [ "$timeout_seconds" -gt 0 ] || die "Timeout must be greater than zero."
}

validate_hostname_value() {
  local hostname="$1"
  local description="$2"

  [ -n "$hostname" ] || die "$description is required."
  [ "${#hostname}" -le 253 ] || die \
    "$description must contain at most 253 characters."
  if [[ ! "$hostname" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$ ]]; then
    die "$description must be a lowercase, fully qualified DNS name."
  fi
}

validate_hostname() {
  HOSTNAME_VALUE="$(printf '%s' "$HOSTNAME_VALUE" | tr '[:upper:]' '[:lower:]')"
  HOSTNAME_VALUE="${HOSTNAME_VALUE%.}"
  [ -n "$HOSTNAME_VALUE" ] || die \
    "A public hostname is required for apply; use --hostname."
  validate_hostname_value "$HOSTNAME_VALUE" "Hostname"
}

normalize_and_validate_mqtts_hostname() {
  MQTTS_HOSTNAME_VALUE="$(printf '%s' "$MQTTS_HOSTNAME_VALUE" | tr '[:upper:]' '[:lower:]')"
  MQTTS_HOSTNAME_VALUE="${MQTTS_HOSTNAME_VALUE%.}"
  [ -n "$MQTTS_HOSTNAME_VALUE" ] || die \
    "An MQTTS hostname is required for Ingress exposure; use --mqtts-hostname."
  validate_hostname_value "$MQTTS_HOSTNAME_VALUE" "MQTTS hostname"
}

validate_apply_options() {
  validate_hostname

  case "$MQTTS_ENABLED" in
    true|false)
      ;;
    *)
      die "OR_EKS_STACK_MQTTS must be true or false."
      ;;
  esac
  if [ "$MQTTS_ENABLED" != true ] && [ "$MQTTS_PORT_CONFIGURED" = true ]; then
    die "Option --mqtts-port requires --mqtts."
  fi
  if [ "$MQTTS_ENABLED" != true ] && \
     { [ -n "$MQTTS_HOSTNAME_VALUE" ] || [ -n "$MQTTS_CERTIFICATE_MODE" ] || \
       [ -n "$MQTTS_CERTIFICATE_ARN" ]; }; then
    die "Options --mqtts-hostname, --mqtts-certificate-mode, and --mqtts-certificate-arn require --mqtts."
  fi

  case "$EXPOSURE" in
    haproxy)
      [ -z "$CERTIFICATE_MODE" ] || die \
        "Option --certificate-mode is only valid with Ingress exposure."
      [ -z "$CERTIFICATE_ARN" ] || die \
        "Option --certificate-arn is only valid with Ingress exposure."
      [ -z "$MQTTS_HOSTNAME_VALUE" ] || die \
        "Option --mqtts-hostname is only valid with Ingress exposure."
      [ -z "$MQTTS_CERTIFICATE_MODE" ] || die \
        "Option --mqtts-certificate-mode is only valid with Ingress exposure."
      [ -z "$MQTTS_CERTIFICATE_ARN" ] || die \
        "Option --mqtts-certificate-arn is only valid with Ingress exposure."
      validate_port "$HTTP_PORT" "HTTP"
      validate_port "$HTTPS_PORT" "HTTPS"
      [ "$HTTP_PORT" != "$HTTPS_PORT" ] || die \
        "HAProxy HTTP and HTTPS ports must be different."
      if [ "$MQTTS_ENABLED" = true ]; then
        validate_port "$MQTTS_PORT" "MQTTS"
        [ "$MQTTS_PORT" != "$HTTP_PORT" ] && [ "$MQTTS_PORT" != "$HTTPS_PORT" ] || die \
          "HAProxy HTTP, HTTPS, and MQTTS ports must be different."
      fi
      [ "$HTTP_PORT" = "80" ] || die \
        "The automated HAProxy ACME workflow requires public HTTP port 80. Use or-stack directly for a custom HTTP port."
      ;;
    ingress)
      if [ "$MQTTS_ENABLED" = true ]; then
        validate_port "$MQTTS_PORT" "MQTTS"
        if [ -n "$MQTTS_HOSTNAME_VALUE" ]; then
          normalize_and_validate_mqtts_hostname
          [ "$MQTTS_HOSTNAME_VALUE" != "$HOSTNAME_VALUE" ] || die \
            "Ingress web and MQTTS hostnames must be different."
        fi
        if [ -n "$MQTTS_CERTIFICATE_ARN" ] && \
           [[ ! "$MQTTS_CERTIFICATE_ARN" =~ ^arn:[^:]+:acm:[a-z0-9-]+:[0-9]{12}:certificate/[A-Za-z0-9-]+$ ]]; then
          die "MQTTS certificate ARN must be a valid ACM certificate ARN."
        fi
        case "$MQTTS_CERTIFICATE_MODE" in
          existing|shared|managed|"") ;;
          *)
            die "Unsupported Ingress MQTTS certificate mode '$MQTTS_CERTIFICATE_MODE'; expected existing, shared, or managed."
            ;;
        esac
        if { [ "$MQTTS_CERTIFICATE_MODE" = shared ] || \
             [ "$MQTTS_CERTIFICATE_MODE" = managed ]; } && \
           [ -n "$MQTTS_CERTIFICATE_ARN" ]; then
          die "Option --mqtts-certificate-arn requires --mqtts-certificate-mode existing; shared and managed modes resolve it automatically."
        fi
      fi
      case "$CERTIFICATE_MODE" in
        existing)
          # An existing stack may reuse its recorded ARN; resolve it after
          # reading namespace metadata, before validating the certificate.
          if [ -n "$CERTIFICATE_ARN" ] && [[ ! "$CERTIFICATE_ARN" =~ ^arn:[^:]+:acm:[a-z0-9-]+:[0-9]{12}:certificate/[A-Za-z0-9-]+$ ]]; then
            die "Certificate ARN must be a valid ACM certificate ARN."
          fi
          ;;
        shared|managed|"")
          [ -z "$CERTIFICATE_ARN" ] || die \
            "Option --certificate-arn requires --certificate-mode existing; shared and managed modes resolve it automatically."
          ;;
        *)
          die "Unsupported Ingress certificate mode '$CERTIFICATE_MODE'; expected existing, shared, or managed."
          ;;
      esac
      [ "$HTTP_PORT" = "80" ] && [ "$HTTPS_PORT" = "443" ] || die \
        "Options --http-port and --https-port are only configurable with HAProxy exposure."
      ;;
    *)
      die "Unsupported exposure '$EXPOSURE'; expected haproxy or ingress."
      ;;
  esac

  if [ -n "$VALUES_DIR" ] && [ ! -d "$VALUES_DIR" ]; then
    die "Values directory '$VALUES_DIR' does not exist."
  fi
}

validate_command_options() {
  if [ "$COMMAND" != "destroy" ] && [ -n "$CONFIRM_STACK_NAME" ]; then
    die "Option --confirm is only valid with destroy."
  fi
  if [ "$COMMAND" = "destroy" ] && [ "$CONFIRM_STACK_NAME" != "$STACK_NAME" ]; then
    die "Destroy requires --confirm '$STACK_NAME'."
  fi
  if [ "$COMMAND" = "apply" ]; then
    validate_apply_options
  fi
}

require_active_cluster() {
  local cluster_status
  local output
  local status

  set +e
  output="$(aws_eks describe-cluster \
    --name "$CLUSTER_NAME" \
    --query 'cluster.status' \
    --output text 2>&1)"
  status=$?
  set -e

  if [ "$status" -ne 0 ]; then
    case "$output" in
      *ResourceNotFoundException*)
        die "EKS cluster '$CLUSTER_NAME' does not exist in region '$AWS_REGION_NAME'."
        ;;
      *)
        die "Unable to query EKS cluster '$CLUSTER_NAME': $output"
        ;;
    esac
  fi

  cluster_status="$output"
  [ "$cluster_status" = "ACTIVE" ] || die \
    "EKS cluster '$CLUSTER_NAME' is '$cluster_status', not ACTIVE."
}

require_matching_kube_context() {
  local configured_context
  local context_endpoint
  local expected_endpoint

  configured_context="$(kubectl config get-contexts "$KUBE_CONTEXT" -o name \
    2>/dev/null || true)"
  [ "$configured_context" = "$KUBE_CONTEXT" ] || die \
    "Kubernetes context '$KUBE_CONTEXT' does not exist; run or-eks-cluster kubeconfig first."

  expected_endpoint="$(aws_eks describe-cluster \
    --name "$CLUSTER_NAME" \
    --query 'cluster.endpoint' \
    --output text)" || die \
      "Unable to read the endpoint for EKS cluster '$CLUSTER_NAME'."
  context_endpoint="$(kubectl --context "$KUBE_CONTEXT" config view \
    --minify \
    -o 'jsonpath={.clusters[0].cluster.server}')" || die \
      "Unable to inspect Kubernetes context '$KUBE_CONTEXT'."

  [ "$context_endpoint" = "$expected_endpoint" ] || die \
    "Kubernetes context '$KUBE_CONTEXT' does not point to EKS cluster '$CLUSTER_NAME'."
  kubectl --context "$KUBE_CONTEXT" get namespace kube-system >/dev/null 2>&1 || die \
    "Kubernetes context '$KUBE_CONTEXT' cannot reach the EKS cluster."
}

require_eks_target() {
  require_command aws
  require_command kubectl
  require_active_cluster
  require_matching_kube_context
}

require_external_dns_argument() {
  local external_dns_args="$1"
  local required_argument="$2"

  grep -Fx -- "$required_argument" <<< "$external_dns_args" >/dev/null || die \
    "ExternalDNS is missing required argument '$required_argument'; run or-eks-cluster apply with the managed DNS configuration."
}

dns_name_is_covered() {
  local dns_name="$1"
  local domain_filter="$2"

  dns_name="${dns_name%.}"
  domain_filter="${domain_filter%.}"
  [ "$dns_name" = "$domain_filter" ] || \
    [[ "$dns_name" == *."$domain_filter" ]]
}

hostname_is_covered() {
  local domain_filter="$1"
  local hostname="${2:-$HOSTNAME_VALUE}"
  dns_name_is_covered "$hostname" "$domain_filter"
}

require_managed_external_dns() {
  local domain_filter
  local external_dns_args
  local hostname_covered=false
  local mqtts_hostname_covered=false
  local service_account_role_arn

  helm status "$EXTERNAL_DNS_RELEASE_NAME" \
    --kube-context "$KUBE_CONTEXT" \
    --namespace kube-system >/dev/null 2>&1 || die \
      "OpenRemote-managed ExternalDNS is not installed; configure it with or-eks-cluster apply first."

  kubectl --context "$KUBE_CONTEXT" --namespace kube-system rollout status \
    "deployment/$EXTERNAL_DNS_RELEASE_NAME" --timeout "$TIMEOUT" >/dev/null || die \
      "ExternalDNS is not ready; inspect deployment/$EXTERNAL_DNS_RELEASE_NAME in kube-system."

  external_dns_args="$(kubectl --context "$KUBE_CONTEXT" \
    --namespace kube-system \
    get deployment "$EXTERNAL_DNS_RELEASE_NAME" \
    -o 'go-template={{range (index .spec.template.spec.containers 0).args}}{{println .}}{{end}}')" || die \
      "Unable to inspect the ExternalDNS deployment."

  if [ "$EXPOSURE" = "ingress" ]; then
    require_external_dns_argument "$external_dns_args" "--source=ingress"
    if [ "$MQTTS_ENABLED" = true ]; then
      require_external_dns_argument "$external_dns_args" "--source=service"
    fi
  else
    require_external_dns_argument "$external_dns_args" "--source=service"
  fi
  require_external_dns_argument "$external_dns_args" "--policy=sync"
  require_external_dns_argument "$external_dns_args" "--registry=txt"
  require_external_dns_argument "$external_dns_args" \
    "--label-filter=openremote.io/managed-dns=true"
  if [ "$CERTIFICATE_MODE" = "managed" ] || \
     [ "$MQTTS_CERTIFICATE_MODE" = "managed" ]; then
    require_external_dns_argument "$external_dns_args" "--source=crd"
    kubectl --context "$KUBE_CONTEXT" get \
      customresourcedefinition/dnsendpoints.externaldns.k8s.io >/dev/null 2>&1 || die \
        "ExternalDNS DNSEndpoint support is missing; run or-eks-cluster apply before using managed certificates."
  fi
  grep -Eq '^--txt-owner-id=.+$' <<< "$external_dns_args" || die \
    "ExternalDNS has no TXT owner ID; reconcile its managed configuration before applying a stack."
  if grep -Eq '^--dry-run(=true)?$' <<< "$external_dns_args"; then
    die "ExternalDNS dry-run is enabled; disable it with or-eks-cluster apply before applying a stack."
  fi

  while IFS= read -r domain_filter; do
    [ -n "$domain_filter" ] || continue
    if hostname_is_covered "$domain_filter"; then
      hostname_covered=true
    fi
    if [ "$MQTTS_ENABLED" = true ] && [ "$EXPOSURE" = ingress ] && \
       hostname_is_covered "$domain_filter" "$MQTTS_HOSTNAME_VALUE"; then
      mqtts_hostname_covered=true
    fi
  done < <(sed -n 's/^--domain-filter=//p' <<< "$external_dns_args")

  [ "$hostname_covered" = true ] || die \
    "ExternalDNS domain filters do not cover '$HOSTNAME_VALUE'; reconcile the cluster DNS configuration first."
  if [ "$MQTTS_ENABLED" = true ] && [ "$EXPOSURE" = ingress ]; then
    [ "$mqtts_hostname_covered" = true ] || die \
      "ExternalDNS domain filters do not cover MQTTS hostname '$MQTTS_HOSTNAME_VALUE'; reconcile the cluster DNS configuration first."
  fi

  service_account_role_arn="$(kubectl --context "$KUBE_CONTEXT" \
    --namespace kube-system \
    get serviceaccount "$EXTERNAL_DNS_SERVICE_ACCOUNT_NAME" \
    -o 'jsonpath={.metadata.annotations.eks\.amazonaws\.com/role-arn}')" || die \
      "Unable to inspect the ExternalDNS ServiceAccount."
  [ -n "$service_account_role_arn" ] || die \
    "ExternalDNS ServiceAccount kube-system/$EXTERNAL_DNS_SERVICE_ACCOUNT_NAME has no IRSA role annotation."

  EXTERNAL_DNS_ARGS="$external_dns_args"
}

require_stack_hostname_subdomain() {
  local domain_filter
  local hostname="${1:-$HOSTNAME_VALUE}"
  # ExternalDNS prefixes ownership TXT names with the record type. At the
  # managed domain itself that name leaves the IAM domain boundary (for example,
  # example.com -> a-example.com). Nested subdomains keep it inside the boundary.
  # This is an apply-only check so it never prevents cleanup of existing state.
  while IFS= read -r domain_filter; do
    domain_filter="${domain_filter%.}"
    [ -n "$domain_filter" ] || continue
    if [[ "$hostname" == *."$domain_filter" ]]; then
      return
    fi
  done < <(sed -n 's/^--domain-filter=//p' <<< "$EXTERNAL_DNS_ARGS")
  die "Hostname '$hostname' must be a strict subdomain of a managed ExternalDNS domain; using the domain itself would place ownership TXT records outside the permitted DNS boundary."
}

read_certificate_namespace() {
  local namespace_json
  namespace_json="$(kubectl --context "$KUBE_CONTEXT" get namespace "$STACK_NAME" \
    --ignore-not-found -o json)" || die "Unable to read the stack's certificate configuration."
  if [ -n "$namespace_json" ]; then
    jq -e --arg stack "$STACK_NAME" '.metadata.labels["openremote.io/stack"] == $stack' \
      <<< "$namespace_json" >/dev/null || die \
        "Namespace '$STACK_NAME' is not owned by this stack; refusing to use its certificate configuration."
  fi
  printf '%s\n' "$namespace_json"
}

resolve_ingress_certificate() {
  local shared_certificate_arn namespace_json recorded_mode recorded_arn

  namespace_json="$(read_certificate_namespace)" || die "Unable to resolve the stack's certificate mode."
  recorded_mode="$(jq -r '.metadata.annotations["openremote.io/certificate-mode"] // empty' <<< "$namespace_json")"
  recorded_arn="$(jq -r '.metadata.annotations["openremote.io/certificate-arn"] // empty' <<< "$namespace_json")"
  if [ -n "$recorded_mode" ]; then
    case "$recorded_mode" in
      existing|shared|managed) ;;
      *) die "Stack '$STACK_NAME' records incompatible certificate mode '$recorded_mode'." ;;
    esac
    [ -z "$CERTIFICATE_MODE" ] || [ "$CERTIFICATE_MODE" = "$recorded_mode" ] || die \
      "Stack '$STACK_NAME' uses certificate mode '$recorded_mode'; in-place certificate mode migration to '$CERTIFICATE_MODE' is not supported."
    # Cluster defaults apply only to first selection. Re-evaluating them on
    # reapply can abandon a managed certificate and make destroy inconsistent.
    CERTIFICATE_MODE="$recorded_mode"
  fi

  case "$CERTIFICATE_MODE" in
    existing)
      CERTIFICATE_ARN="${CERTIFICATE_ARN:-$recorded_arn}"
      [ -n "$CERTIFICATE_ARN" ] || die "Ingress with certificate mode existing requires --certificate-arn on first apply."
      return
      ;;
    managed)
      return
      ;;
  esac

  if ! shared_certificate_arn="$(kubectl --context "$KUBE_CONTEXT" \
      get ingressclass openremote-alb \
      -o "go-template={{with .metadata.annotations}}{{with index . \"$SHARED_CERTIFICATE_ARN_ANNOTATION\"}}{{.}}{{end}}{{end}}" \
      2>/dev/null)"; then
    die "Unable to inspect shared certificate configuration on IngressClass 'openremote-alb'."
  fi
  if [ -z "$shared_certificate_arn" ]; then
    if [ "$CERTIFICATE_MODE" = "shared" ]; then
      die "Ingress certificate mode shared requires a certificate configured with or-eks-cluster --shared-certificate-arn."
    fi
    CERTIFICATE_MODE=managed
    log "No shared ACM certificate is configured; selected stack-managed certificate mode."
    return
  fi

  CERTIFICATE_MODE=shared
  CERTIFICATE_ARN="$shared_certificate_arn"
  log "Selected the cluster's shared ACM certificate '$CERTIFICATE_ARN'."
}

resolve_ingress_mqtts_configuration() {
  local namespace_json
  local recorded_arn
  local recorded_hostname
  local recorded_mode
  local requested_arn="$MQTTS_CERTIFICATE_ARN"
  local requested_mode="$MQTTS_CERTIFICATE_MODE"
  local shared_certificate_arn=""

  namespace_json="$(read_certificate_namespace)" || die \
    "Unable to resolve the stack's MQTTS certificate configuration."
  recorded_hostname="$(jq -r '.metadata.annotations["openremote.io/mqtts-hostname"] // empty' \
    <<< "$namespace_json")"
  recorded_mode="$(jq -r '.metadata.annotations["openremote.io/mqtts-certificate-mode"] // empty' \
    <<< "$namespace_json")"
  recorded_arn="$(jq -r '.metadata.annotations["openremote.io/mqtts-certificate-arn"] // empty' \
    <<< "$namespace_json")"

  if [ "$MQTTS_ENABLED" != true ]; then
    if [ -n "$recorded_hostname" ] || [ -n "$recorded_mode" ] || [ -n "$recorded_arn" ]; then
      die "Stack '$STACK_NAME' records an Ingress MQTTS endpoint; repeat --mqtts to preserve it. Disabling it in place is not supported."
    fi
    return
  fi

  case "$recorded_mode" in
    existing|shared|managed|"") ;;
    *) die "Stack '$STACK_NAME' records incompatible MQTTS certificate mode '$recorded_mode'." ;;
  esac
  if [ -z "$recorded_mode" ] && [ -n "$recorded_arn" ]; then
    die "Stack '$STACK_NAME' has incomplete MQTTS certificate state; inspect its namespace annotations before retrying."
  fi
  if [ -n "$recorded_mode" ]; then
    [ -z "$requested_mode" ] || [ "$requested_mode" = "$recorded_mode" ] || die \
      "Stack '$STACK_NAME' uses MQTTS certificate mode '$recorded_mode'; in-place certificate mode migration to '$requested_mode' is not supported."
    MQTTS_CERTIFICATE_MODE="$recorded_mode"
  elif [ -z "$MQTTS_CERTIFICATE_MODE" ]; then
    if [ -n "$requested_arn" ]; then
      MQTTS_CERTIFICATE_MODE=existing
    else
      if ! shared_certificate_arn="$(kubectl --context "$KUBE_CONTEXT" \
          get ingressclass openremote-alb \
          -o "go-template={{with .metadata.annotations}}{{with index . \"$SHARED_CERTIFICATE_ARN_ANNOTATION\"}}{{.}}{{end}}{{end}}" \
          2>/dev/null)"; then
        die "Unable to inspect shared MQTTS certificate configuration on IngressClass 'openremote-alb'."
      fi
      if [ -n "$shared_certificate_arn" ]; then
        MQTTS_CERTIFICATE_MODE=shared
      else
        MQTTS_CERTIFICATE_MODE=managed
        log "No shared MQTTS certificate is configured; selected stack-managed MQTTS certificate mode."
      fi
    fi
  fi

  if [ -n "$recorded_hostname" ]; then
    if [ -n "$MQTTS_HOSTNAME_VALUE" ] && \
       [ "${MQTTS_HOSTNAME_VALUE%.}" != "${recorded_hostname%.}" ]; then
      die "Stack '$STACK_NAME' uses MQTTS hostname '$recorded_hostname'; in-place hostname migration to '$MQTTS_HOSTNAME_VALUE' is not supported."
    fi
    MQTTS_HOSTNAME_VALUE="$recorded_hostname"
  fi
  [ -n "$MQTTS_HOSTNAME_VALUE" ] || die \
    "Ingress MQTTS requires --mqtts-hostname on first apply."
  normalize_and_validate_mqtts_hostname
  [ "$MQTTS_HOSTNAME_VALUE" != "$HOSTNAME_VALUE" ] || die \
    "Ingress web and MQTTS hostnames must be different."

  case "$MQTTS_CERTIFICATE_MODE" in
    existing)
      MQTTS_CERTIFICATE_ARN="${requested_arn:-$recorded_arn}"
      [ -n "$MQTTS_CERTIFICATE_ARN" ] || die \
        "Ingress MQTTS certificate mode existing requires --mqtts-certificate-arn on first apply."
      ;;
    shared)
      [ -z "$requested_arn" ] || die \
        "Option --mqtts-certificate-arn cannot be used with shared MQTTS certificate mode."
      if [ -z "$shared_certificate_arn" ]; then
        if ! shared_certificate_arn="$(kubectl --context "$KUBE_CONTEXT" \
            get ingressclass openremote-alb \
            -o "go-template={{with .metadata.annotations}}{{with index . \"$SHARED_CERTIFICATE_ARN_ANNOTATION\"}}{{.}}{{end}}{{end}}" \
            2>/dev/null)"; then
          die "Unable to inspect shared MQTTS certificate configuration on IngressClass 'openremote-alb'."
        fi
      fi
      [ -n "$shared_certificate_arn" ] || die \
        "Ingress MQTTS certificate mode shared requires a certificate configured with or-eks-cluster --shared-certificate-arn."
      MQTTS_CERTIFICATE_ARN="$shared_certificate_arn"
      log "Selected the cluster's shared ACM certificate '$MQTTS_CERTIFICATE_ARN' for MQTTS."
      ;;
    managed)
      [ -z "$requested_arn" ] || die \
        "Option --mqtts-certificate-arn cannot be used with managed MQTTS certificate mode."
      # A recorded managed ARN is loaded and ownership-checked after the
      # namespace and hostname reservations have been prepared.
      MQTTS_CERTIFICATE_ARN=""
      ;;
  esac
}

record_initial_certificate_mode() {
  local namespace_json recorded_mode resource_version
  local annotations=("$CERTIFICATE_MODE_ANNOTATION=$CERTIFICATE_MODE")
  namespace_json="$(read_certificate_namespace)" || die "Unable to record the stack's certificate mode."
  [ -n "$namespace_json" ] || die "Prepared namespace '$STACK_NAME' is missing; unable to record certificate mode."
  recorded_mode="$(jq -r '.metadata.annotations["openremote.io/certificate-mode"] // empty' <<< "$namespace_json")"
  if [ -n "$recorded_mode" ]; then
    [ "$recorded_mode" = "$CERTIFICATE_MODE" ] || die \
      "Stack '$STACK_NAME' now uses certificate mode '$recorded_mode'; in-place certificate mode migration is not supported. Retry apply with that mode."
    return
  fi
  resource_version="$(jq -er '.metadata.resourceVersion | select(type == "string" and length > 0)' \
    <<< "$namespace_json")" || die "Unable to verify namespace version before recording certificate mode."
  if [ "$CERTIFICATE_MODE" = existing ] || [ "$CERTIFICATE_MODE" = shared ]; then
    annotations+=("$CERTIFICATE_ARN_ANNOTATION=$CERTIFICATE_ARN")
  fi
  # Pin the mode before ACM requests or Helm. The conditional write prevents
  # two initial applies from choosing different modes. Retain it after failure;
  # managed mode without an ARN resumes through existing tagged-ACM discovery.
  kubectl --context "$KUBE_CONTEXT" annotate namespace "$STACK_NAME" \
    "${annotations[@]}" --overwrite --resource-version="$resource_version" >/dev/null || die \
      "Unable to record certificate mode; the namespace may have changed concurrently. Retry apply."
}

record_initial_mqtts_configuration() {
  local namespace_json
  local recorded_hostname
  local recorded_mode
  local resource_version

  [ "$EXPOSURE" = ingress ] && [ "$MQTTS_ENABLED" = true ] || return 0
  namespace_json="$(read_certificate_namespace)" || die \
    "Unable to record the stack's MQTTS lifecycle configuration."
  [ -n "$namespace_json" ] || die \
    "Prepared namespace '$STACK_NAME' is missing; unable to record MQTTS lifecycle configuration."
  recorded_mode="$(jq -r '.metadata.annotations["openremote.io/mqtts-certificate-mode"] // empty' \
    <<< "$namespace_json")"
  recorded_hostname="$(jq -r '.metadata.annotations["openremote.io/mqtts-hostname"] // empty' \
    <<< "$namespace_json")"
  if [ -n "$recorded_mode" ]; then
    [ "$recorded_mode" = "$MQTTS_CERTIFICATE_MODE" ] || die \
      "Stack '$STACK_NAME' now uses MQTTS certificate mode '$recorded_mode', not '$MQTTS_CERTIFICATE_MODE'."
    [ -n "$recorded_hostname" ] || die \
      "Stack '$STACK_NAME' has incomplete MQTTS lifecycle configuration."
    [ "$recorded_hostname" = "$MQTTS_HOSTNAME_VALUE" ] || die \
      "Stack '$STACK_NAME' now records MQTTS hostname '$recorded_hostname', not '$MQTTS_HOSTNAME_VALUE'."
    return
  fi
  resource_version="$(jq -er '.metadata.resourceVersion | select(type == "string" and length > 0)' \
    <<< "$namespace_json")" || die \
      "Unable to verify namespace version before recording MQTTS lifecycle configuration."
  # Record the facade's ownership mode before ACM requests or Helm. If apply is
  # interrupted, destroy can still distinguish this workflow from a low-level
  # or-stack endpoint. Existing-mode ARNs are recorded only after Helm succeeds
  # so rotation never advances namespace state ahead of the Service. Managed
  # mode records its ARN immediately after an owned certificate is resolved.
  kubectl --context "$KUBE_CONTEXT" annotate namespace "$STACK_NAME" \
    "$MQTTS_CERTIFICATE_MODE_ANNOTATION=$MQTTS_CERTIFICATE_MODE" \
    "$MQTTS_HOSTNAME_ANNOTATION=$MQTTS_HOSTNAME_VALUE" \
    --overwrite --resource-version="$resource_version" >/dev/null || die \
      "Unable to record MQTTS lifecycle configuration; the namespace may have changed concurrently. Retry apply."
}

certificate_name_covers_hostname() {
  local certificate_name
  local hostname="${2:-$HOSTNAME_VALUE}"
  local wildcard_suffix

  certificate_name="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  certificate_name="${certificate_name%.}"
  if [ "$certificate_name" = "$hostname" ]; then
    return 0
  fi

  case "$certificate_name" in
    \*.*)
      wildcard_suffix="${certificate_name#*.}"
      [ "${hostname#*.}" = "$wildcard_suffix" ]
      ;;
    *)
      return 1
      ;;
  esac
}

require_selected_mqtts_acm_certificate() {
  local certificate_account
  local certificate_json
  local certificate_name
  local certificate_region
  local certificate_status
  local certificate_tags
  local current_account
  local describe_status
  local hostname_covered=false
  local tags_status

  if [[ ! "$MQTTS_CERTIFICATE_ARN" =~ ^arn:[^:]+:acm:([^:]+):([0-9]{12}):certificate/[A-Za-z0-9-]+$ ]]; then
    die "MQTTS certificate ARN must be a valid ACM certificate ARN."
  fi
  certificate_region="${BASH_REMATCH[1]}"
  certificate_account="${BASH_REMATCH[2]}"
  [ "$certificate_region" = "$AWS_REGION_NAME" ] || die \
    "MQTTS certificate '$MQTTS_CERTIFICATE_ARN' is in region '$certificate_region', but cluster '$CLUSTER_NAME' is in '$AWS_REGION_NAME'."
  current_account="$(aws_sts get-caller-identity --query Account --output text)" || die \
    "Unable to determine the EKS AWS account."
  [ "$certificate_account" = "$current_account" ] || die \
    "MQTTS certificate '$MQTTS_CERTIFICATE_ARN' belongs to account '$certificate_account', but the EKS account is '$current_account'."

  set +e
  certificate_json="$(aws_acm describe-certificate \
    --certificate-arn "$MQTTS_CERTIFICATE_ARN" \
    --output json 2>&1)"
  describe_status=$?
  set -e
  [ "$describe_status" -eq 0 ] || die \
    "Unable to describe MQTTS ACM certificate '$MQTTS_CERTIFICATE_ARN': $certificate_json"
  certificate_status="$(jq -r '.Certificate.Status // empty' <<< "$certificate_json")" || die \
    "Unable to read MQTTS ACM certificate metadata."
  [ "$certificate_status" = ISSUED ] || die \
    "The MQTTS ACM certificate '$MQTTS_CERTIFICATE_ARN' is '$certificate_status', not ISSUED."

  while IFS= read -r certificate_name; do
    [ -n "$certificate_name" ] || continue
    if certificate_name_covers_hostname "$certificate_name" "$MQTTS_HOSTNAME_VALUE"; then
      hostname_covered=true
      break
    fi
  done < <(jq -r \
    '[.Certificate.DomainName, .Certificate.SubjectAlternativeNames[]?] | unique[] | select(. != null)' \
    <<< "$certificate_json")
  [ "$hostname_covered" = true ] || die \
    "The MQTTS ACM certificate '$MQTTS_CERTIFICATE_ARN' does not cover '$MQTTS_HOSTNAME_VALUE'."

  set +e
  certificate_tags="$(aws_acm list-tags-for-certificate \
    --certificate-arn "$MQTTS_CERTIFICATE_ARN" \
    --output json 2>&1)"
  tags_status=$?
  set -e
  [ "$tags_status" -eq 0 ] || die \
    "Unable to inspect ownership tags on MQTTS ACM certificate '$MQTTS_CERTIFICATE_ARN': $certificate_tags"
  if jq -e \
      --arg key "$CERTIFICATE_MANAGED_BY_TAG_KEY" \
      --arg value "$CERTIFICATE_MANAGED_BY_TAG_VALUE" \
      '.Tags[]? | select(.Key == $key and .Value == $value)' \
      <<< "$certificate_tags" >/dev/null; then
    if [ "$MQTTS_CERTIFICATE_MODE" = shared ]; then
      die "MQTTS certificate '$MQTTS_CERTIFICATE_ARN' is marked as managed by or-eks-stack and cannot be used in shared mode."
    fi
    die "MQTTS certificate '$MQTTS_CERTIFICATE_ARN' is marked as managed by or-eks-stack and cannot be used as an existing certificate."
  fi

  if [ "$MQTTS_CERTIFICATE_MODE" = shared ]; then
    log "Validated externally managed shared ACM certificate '$MQTTS_CERTIFICATE_ARN' for MQTTS hostname '$MQTTS_HOSTNAME_VALUE'."
  else
    log "Validated user-owned ACM certificate '$MQTTS_CERTIFICATE_ARN' for MQTTS hostname '$MQTTS_HOSTNAME_VALUE'."
  fi
}

require_selected_acm_certificate() {
  local certificate_account
  local certificate_json
  local certificate_name
  local certificate_region
  local certificate_status
  local certificate_tags
  local current_account
  local describe_status
  local hostname_covered=false
  local tags_status

  if [[ ! "$CERTIFICATE_ARN" =~ ^arn:[^:]+:acm:([^:]+):([0-9]{12}):certificate/[A-Za-z0-9-]+$ ]]; then
    die "Certificate ARN must be a valid ACM certificate ARN."
  fi
  certificate_region="${BASH_REMATCH[1]}"
  certificate_account="${BASH_REMATCH[2]}"

  [ "$certificate_region" = "$AWS_REGION_NAME" ] || die \
    "Certificate '$CERTIFICATE_ARN' is in region '$certificate_region', but cluster '$CLUSTER_NAME' is in '$AWS_REGION_NAME'."
  current_account="$(aws_sts get-caller-identity --query Account --output text)" || die \
    "Unable to determine the EKS AWS account."
