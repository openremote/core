# Non-secret settings. Replace example values in the customer repository.
# Stable across instance replacement; do not include instance IDs or release IDs.
MONITORING_COMPOSE_PROJECT=alloy-customer-staging
ALLOY_DATA_VOLUME=alloy-customer-staging-data
ALLOY_HTTP_PORT=12345
ALLOY_CUSTOMER=customer
ALLOY_ENVIRONMENT=staging
ALLOY_HOST=staging.customer.example
ALLOY_AWS_ACCOUNT_ID=123456789012
# Match the existing host series identity at the agreed scrape cutover.
HOST_METRICS_INSTANCE=staging.customer.example
HOST_METRICS_JOB=customer-staging-node
ALLOY_METRICS_JOB=customer-staging-alloy
SOURCE_COMPOSE_PROJECT=or
SOURCE_COMPOSE_SERVICES_REGEX=(manager|proxy|postgresql|keycloak)
LOKI_URL=https://loki.example.com/loki/api/v1/push
LOKI_USERNAME=alloy-customer
LOKI_PASSWORD_FILE=/etc/openremote/alloy/loki_password
METRICS_URL=https://metrics.example.com/api/v1/write
METRICS_USERNAME=metrics-customer
METRICS_PASSWORD_FILE=/etc/openremote/alloy/metrics_password

# Required only with compose.traces.yaml. Replace with this host's private IP
# for bridge-network application containers; loopback works only for local clients.
# Never use a public address or a wildcard such as 0.0.0.0 or [::].
# OTLP_GRPC_LISTEN_ADDRESS=10.0.1.10:4317
# OTLP_HTTP_LISTEN_ADDRESS=10.0.1.10:4318
# TEMPO_OTLP_ENDPOINT=https://tempo.example.com
